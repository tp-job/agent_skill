;endArrow=open;endFill=0;fontColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="659" y="3063" as="sourcePoint"/><mxPoint x="719" y="3063" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p0-lget2" value="อ้างอิง / ใช้ประกอบ" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="729" y="3051" width="210" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="2 รอบการแก้ไข (iteration loop)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1-title" value="&lt;b style=&quot;font-size:24px&quot;&gt;athena-erechtheion › references/iteration-loop.md&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#555555&quot;&gt;อัปเดต → ประเมินผล → แก้ไข → ตัดสินว่า feedback เป็นบวกไหม → วิเคราะห์ได้–เสีย → ตัดสินใจ&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="69" y="10" width="1328" height="70" as="geometry"/></mxCell><mxCell id="p1-S" value="มี draft ที่แก้แล้ว&lt;br&gt;+ feedback" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="505" y="117" width="230" height="66" as="geometry"/></mxCell><mxCell id="p1-D0" value="เป็น draft แรก / sketch สำรวจ&lt;br&gt;/ แก้ค่าเดียวที่ตรวจได้?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="485" y="247" width="270" height="120" as="geometry"/></mxCell><mxCell id="p1-NO" value="ไม่ต้องทำรอบ&lt;br&gt;รีวิวอย่างเดียว หรือรันเช็กแล้วจดผล" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1065" y="274" width="270" height="66" as="geometry"/></mxCell><mxCell id="p1-DCL" value="มีรายการแก้ (change list)&lt;br&gt;จากรอบก่อนไหม?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="490" y="422" width="260" height="116" as="geometry"/></mxCell><mxCell id="p1-PICK" value="กลับไปที่ review note&lt;br&gt;เลือก finding 1–5 ข้อ&lt;br&gt;('ทำให้ดีขึ้น' ไม่นับ)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="215" y="440" width="230" height="80" as="geometry"/></mxCell><mxCell id="p1-S1" value="&lt;b&gt;1 อัปเดต&lt;/b&gt;&lt;br&gt;แก้เฉพาะตามรายการ 1–5 ข้อ&lt;br&gt;แต่ละข้อโยงกับ finding หรือคำพูด" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="480" y="600" width="280" height="90" as="geometry"/></mxCell><mxCell id="p1-S2" value="&lt;b&gt;2 ประเมินผล&lt;/b&gt;&lt;br&gt;รันเช็ก 1 (thesis) + เช็กที่โดนแก้&lt;br&gt;เก็บ feedback ผู้นำแบบคำต่อคำ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="480" y="765" width="280" height="90" as="geometry"/></mxCell><mxCell id="p1-S3" value="&lt;b&gt;3 แก้ไข&lt;/b&gt;&lt;br&gt;แก้เฉพาะ blocker ที่เพิ่งเจอ&lt;br&gt;ไอเดียใหม่ → จดไว้ทำรอบหน้า" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="480" y="930" width="280" height="90" as="geometry"/></mxCell><mxCell id="p1-DFB" value="มี feedback ที่เป็น&lt;br&gt;คำพูดชัดเจนไหม?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="1082" width="250" height="116" as="geometry"/></mxCell><mxCell id="p1-ASK" value="'สวยดี' / เงียบ ≠ บวก&lt;br&gt;ถามผู้นำ 1 คำถาม&lt;br&gt;+ ค่าเริ่มต้นถ้าไม่ตอบ" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="930" y="1100" width="250" height="80" as="geometry"/></mxCell><mxCell id="p1-S4" value="&lt;b&gt;4 ตัดสิน feedback&lt;/b&gt;&lt;br&gt;บวก / ผสม / ลบ ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="1252" width="250" height="120" as="geometry"/></mxCell><mxCell id="p1-POS" value="&lt;b&gt;บวก&lt;/b&gt;&lt;br&gt;ไม่มี blocker · ผ่านเทสต์เป้าหมาย&lt;br&gt;· ผู้นำรับโดยไม่มี 'แต่'" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="205" y="1447" width="250" height="90" as="geometry"/></mxCell><mxCell id="p1-MIX" value="&lt;b&gt;ผสม&lt;/b&gt;&lt;br&gt;รับทิศทาง แต่ยังมี&lt;br&gt;blocker หรือข้อติที่ระบุชื่อ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="1447" width="250" height="90" as="geometry"/></mxCell><mxCell id="p1-NEG" value="&lt;b&gt;ลบ&lt;/b&gt;&lt;br&gt;เช็ก 1–2 ไม่ผ่าน · ปฏิเสธทิศทาง&lt;br&gt;· แย่กว่ารอบก่อนในเป้าของรอบ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="794" y="1447" width="260" height="90" as="geometry"/></mxCell><mxCell id="p1-S5" value="&lt;b&gt;5 วิเคราะห์ได้–เสีย&lt;/b&gt;&lt;br&gt;ทุกจุดที่แก้: ได้อะไร / เสียอะไร (มีหลักฐาน)&lt;br&gt;เทียบรอบก่อน + เช็ก Keep ของรอบแรก" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="460" y="1622" width="320" height="100" as="geometry"/></mxCell><mxCell id="p1-COST" value="&lt;b&gt;ต้นทุนมักซ่อนอยู่ที่&lt;/b&gt;&lt;br&gt;• breakpoint อื่น · state อื่น&lt;br&gt;• กฎ 'ห้าม' · น้ำหนักไฟล์&lt;br&gt;• แรงที่ใช้สร้าง · จอที่ไม่ได้แตะ&lt;br&gt;ถ้าเขียนว่า 'ไม่มีต้นทุน' = ยังไม่ได้ดู" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=10;spacingRight=6;fontColor=#333333;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="982" y="1607" width="290" height="130" as="geometry"/></mxCell><mxCell id="p1-LOG" value="&lt;b&gt;เขียน round log&lt;/b&gt;&lt;br&gt;แก้อะไร · หลักฐาน · feedback&lt;br&gt;· ตัดสิน · ได้ · เสีย · ตัดสินใจ" style="shape=document;size=0.15;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#e1d5e7;strokeColor=#9673a6;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="480" y="1802" width="280" height="100" as="geometry"/></mxCell><mxCell id="p1-DN" value="ผลตัดสินรอบนี้?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="1967" width="250" height="116" as="geometry"/></mxCell><mxCell id="p1-HAND" value="ส่งงาน&lt;br&gt;+ เขียน design record" style="shape=document;size=0.15;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#e1d5e7;strokeColor=#9673a6;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="205" y="2149" width="250" height="96" as="geometry"/></mxCell><mxCell id="p1-EH" value="จบ: ส่งต่อทีม build" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="215" y="2329" width="230" height="66" as="geometry"/></mxCell><mxCell id="p1-DLIM" value="ข้อเดิม 'ผสม' 2 รอบติด&lt;br&gt;หรือ blocker เดิมเกิน 2 รอบ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="485" y="2137" width="270" height="120" as="geometry"/></mxCell><mxCell id="p1-NEXT" value="ตั้งรายการแก้รอบถัดไป&lt;br&gt;(1–5 ข้อ)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="505" y="2337" width="230" height="80" as="geometry"/></mxCell><mxCell id="p1-DW" value="แย่กว่ารอบก่อน&lt;br&gt;ในเป้าของรอบนี้?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="872" y="1967" width="250" height="116" as="geometry"/></mxCell><mxCell id="p1-REV" value="ถอยกลับไปใช้&lt;br&gt;draft รอบก่อนเป็นฐาน" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1177" y="1985" width="220" height="80" as="geometry"/></mxCell><mxCell id="p1-SYM" value="&lt;b&gt;หาขั้นที่เป็นต้นเหตุ&lt;/b&gt;&lt;br&gt;• 'เหมือนเว็บใครก็ได้' → กำกับศิลป์&lt;br&gt;• 'ดูไม่เข้ากัน' / สีแรงไป → กำกับศิลป์&lt;br&gt;• 'ไม่ชอบสักอัน' → ความคิดสร้างสรรค์&lt;br&gt;• ขาดหน้าจอ/สถานะ → สถาปัตยกรรม&lt;br&gt;• เทสต์เป้าหมายตก 2 ครั้ง → ขั้น 0&lt;br&gt;• พังกับข้อความจริง / 375px → แก้ในร่างต่อ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="837" y="2142" width="320" height="170" as="geometry"/></mxCell><mxCell id="p1-ASK2" value="ถามผู้นำ 1 คำถาม&lt;br&gt;พร้อมค่าเริ่มต้น" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="882" y="2405" width="230" height="80" as="geometry"/></mxCell><mxCell id="p1-EB" value="กลับไปทำขั้นนั้นใหม่&lt;br&gt;(ดูหน้า 1)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="882" y="2562" width="230" height="66" as="geometry"/></mxCell><mxCell id="p1-e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;" edge="1" parent="1" source="p1-S" target="p1-D0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e1" value="ใช่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-D0" target="p1-NO"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e2" value="ไม่ใช่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;" edge="1" parent="1" source="p1-D0" target="p1-DCL"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e3" value="ไม่มี" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-DCL" target="p1-PICK"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-PICK" target="p1-S1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e5" value="มี" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;" edge="1" parent="1" source="p1-DCL" target="p1-S1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;" edge="1" parent="1" source="p1-S1" target="p1-S2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;" edge="1" parent="1" source="p1-S2" target="p1-S3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;" edge="1" parent="1" source="p1-S3" target="p1-DFB"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e9" value="ไม่มี" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-DFB" target="p1-ASK"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e