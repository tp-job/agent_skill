Color=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="110" width="260" height="64" as="geometry"/></mxCell><mxCell id="sk-reviews-and-reporting-FK-0" value="&lt;b&gt;Daily brief&lt;/b&gt;&lt;br&gt;นัดตามเวลา → งาน → กิจกรรม → เลยกำหนด" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="62" y="260" width="230" height="80" as="geometry"/></mxCell><mxCell id="sk-reviews-and-reporting-FK-1" value="&lt;b&gt;Wrap-up&lt;/b&gt;&lt;br&gt;ถามทีละงาน เสร็จ/คืบ/ยัง → อัปเดต → เสนอวางแผนพรุ่งนี้" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="318" y="260" width="230" height="80" as="geometry"/></mxCell><mxCell id="sk-reviews-and-reporting-FK-2" value="&lt;b&gt;Weekly review&lt;/b&gt;&lt;br&gt;เสร็จ · หลุด · ค้าง 7 วัน · เวลา · กิจกรรม · สัปดาห์หน้า" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="572" y="260" width="230" height="80" as="geometry"/></mxCell><mxCell id="sk-reviews-and-reporting-FK-3" value="&lt;b&gt;Activity tracking&lt;/b&gt;&lt;br&gt;เป้า vs ทำจริง · streak" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="828" y="260" width="230" height="80" as="geometry"/></mxCell><mxCell id="sk-reviews-and-reporting-RL" value="&lt;b&gt;กฎทุกรายงาน&lt;/b&gt;&lt;br&gt;ช่วงวัน + time zone · ไล่ข้อมูลครบทุกหน้า · ลิงก์งานด้วยชื่อ · แยกข้อเท็จจริง / อนุมาน" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="400" width="300" heig