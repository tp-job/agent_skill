nded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="89" y="2238" as="sourcePoint"/><mxPoint x="149" y="2238" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1-lget0" value="เส้นทางหลัก" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="159" y="2226" width="210" height="24" as="geometry"/></mxCell><mxCell id="p1-lge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;strokeColor=#b85450;dashed=1;fontColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="374" y="2238" as="sourcePoint"/><mxPoint x="434" y="2238" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1-lget1" value="วนกลับ (loop)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="444" y="2226" width="210" height="24" as="geometry"/></mxCell><mxCell id="p1-lge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;strokeColor=#999999;dashed=1;dashPattern=1 3;endArrow=open;endFill=0;fontColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="659" y="2238" as="sourcePoint"/><mxPoint x="719" y="2238" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1-lget2" value="อ้างอิง / ใช้ประกอบ" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="729" y="2226" width="210" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="sk-capture-and-triage" name="3 capture-and-triage: จาก brain dump สู่รายการ"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sk-capture-and-triage-title" value="&lt;b style=&quot;font-size:24px&quot;&gt;capture and triage — แยก จำแนก กรอก กันซ้ำ แล้วเขียน&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#555555&quot;&gt;หนึ่งรายการ = หนึ่งชนิด · ชื่องานเป็นผลลัพธ์ · ไม่เดาวัน · เขียนหลังได้ yes เท่านั้น&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395.0" y="10" width="1400" height="70" as="geometry"/></mxCell><mxCell id="sk-capture-and-triage-S" value="เริ่ม&lt;br&gt;brain dump / โน้ตประชุม / อีเมลที่มี action" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="110" width="260" height="82" as="geometry"/></mxCell><mxCell id="sk-capture-and-triage-SP" value="&lt;b&gt;1 แยกบรรทัดละรายการ&lt;/b&gt;&lt;br&gt;&#x27;โทรหา Anna แล้วส่ง deck&#x27; = 2 รายการ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="252" width="300" height="62" as="geometry"/></mxCell><mxCell id="sk-capture-and-triage-CX" value="เป็นแค่บริบท?&lt;br&gt;(&#x27;launch ไปไม่ดี&#x27;)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="374" width="330" height="100" as="geometry"/></mxCell><mxCell id="sk-capture-and-triage-CX-R" value="ไม่สร้างรายการ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="396" width="300" height="56" as="geometry"/></mxCell><mxCell id="sk-capture-and-triage-CL" value="&lt;b&gt;2 จำแนก นัด / งาน / กิจกรรม&lt;/b&gt;&lt;br&gt;ไม่ชัด → chronos.py classify" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="534" width="300" height="62" as="geometry"/></mxCell><mxCell id="sk-capture-and-triage-FL" value="&lt;b&gt;3 กรอก field ที่ชนิดนั้นต้องการ&lt;/b&gt;&lt;br&gt;ไม่รู้ = เว้นว่าง + ทำเครื่องหมาย" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="656" width="300" height="62" as="geometry"/></mxCell><mxCell id="sk-capture-and-triage-DD" value="&lt;b&gt;4 กันซ้ำ&lt;/b&gt;&lt;br&gt;ค้น Calendar + ClickUp ก่อนเสนอเป็นของใหม่" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="778" width="300" height="62" as="geometry"/></mxCell><mxCell id="sk-capture-and-triage-TB" value="&lt;b&gt;5 ตาราง triage&lt;/b&gt;&lt;br&gt;ชนิด · ปลายทาง · field · ใหม่/มีแล้ว/อัปเดต&lt;br&gt;ถาม field ที่ขาดในข้อความเดียว" style="shape=document;size=0.15;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#e1d5e7;strokeColor=#9673a6;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="900" width="300" height="94" as="geometry"/></mxCell><mxCell id="sk-capture-and-triage-OK" value="ผู้ใช้ตอบ yes?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="1054" width="330" height="100" as="geometry"/></mxCell><mxCell id="sk-capture-and-triage-WR" value="&lt;b&gt;6 เขียนตามลำดับ&lt;/b&gt;&lt;br&gt;นัด → งาน → block กิจกรรม&lt;br&gt;(block ต้องใช้เวลาว่างที่เหลือจากนัด)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="1214" width="300" height="80" as="geometry"/></mxCell><mxCell id="sk-capture-and-triage-END" value="รายงานผลทีละรายการ" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="1354" width="260" height="60" as="geometry"/></mxCell><mxCell id="sk-capture-and-triage-note" value="&lt;b&gt;ห้าม&lt;/b&gt;&lt;br&gt;• สร้างรายการจากสิ่งที่เป็นแค่บริบท&lt;br&gt;• เดาวันจาก &#x27;เร็วๆ นี้&#x27;&lt;br&gt;• ตั้ง urgent เอง&lt;br&gt;• มอบงานให้คนอื่นเอง&lt;br&gt;&lt;br&gt;&lt;b&gt;BAD &#x27;Anna&#x27; → BETTER &#x27;Send pricing deck to Anna&#x27;&lt;/b&gt;" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=10;spacingRight=6;fontColor=#333333;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1225" y="110" width="320" height="170" as="geometry"/></mxCell><mxCell id="sk-capture-and-triage-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-capture-and-triage-S" target="sk-capture-and-triage-SP"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sk-capture-and-triage-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-capture-and-triage-SP" target="sk-capture-and-triage-CX"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sk-capture-and-triage-e3" value="ไม่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-capture-and-triage-CX" target="sk-capture-and-triage-CL"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sk-capture-and-triage-e4" value="ใช่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-capture-and-triage-CX" target="sk-capture-and-triage-CX-R"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sk-capture-and-triage-e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;strokeColor=#b85450;dashed=1;fontColor=#b85450;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-capture-and-triage-CX-R" target="sk-capture-and-triage-SP"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1155" y="424"/><mxPoint x="1155" y="283"/></Array></mxGeometry></mxCell><mxCell id="sk-capture-and-triage-e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-capture-and-triage-CL" target="sk-capture-and-triage-FL"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sk-capture-and-triage-e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-capture-and-triage-FL" target="sk-capture-and-triage-DD"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sk-capture-and-triage-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-capture-and-triage-DD" target="sk-capture-and-triage-TB"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sk-capture-and-triage-e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-capture-and-triage-TB" target="sk-capture-and-triage-OK"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sk-capture-and-triage-e10" value="ใช่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-capture-and-triage-OK" target="sk-capture-and-triage-WR"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sk-capture-and-triage-e11" value="ไม่ / แก้" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;strokeColor=#b85450;dashed=1;fontColor=#b85450;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-capture-and-triage-OK" target="sk-capture-and-triage-FL"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="355" y="1104"/><mxPoint x="355" y="687"/></Array></mxGeometry></mxCell><mxCell id="sk-capture-and-triage-e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-capture-and-triage-WR" target="sk-capture-and-triage-END"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="sk-planning-and-time-blocking" name="4 planning-and-time-blocking: วางแผนวัน"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sk-planning-and-time-blocking-title" value="&lt;b style=&quot;font-size:24px&quot;&gt;planning and time-blocking — จัดตารางวัน / สัปดาห์&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#555555&quot;&gt;อ่านวัน → อ่านงาน → reconcile → คำนวณ load → เสนอ → เขียนหลัง yes → สิ้นวันเก็บงานที่หลุด&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395.0" y="10" width="1400" height="70" as="geometry"/></mxCell><mxCell id="sk-planning-and-time-blocking-S" value="เริ่ม&lt;br&gt;&#x27;จัดตารางวันนี้&#x27; / &#x27;งานล้นไหม&#x27;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="110" width="260" height="64" as="geometry"/></mxCell><mxCell id="sk-planning-and-time-blocking-R1" value="&lt;b&gt;1 อ่านวัน&lt;/b&gt;&lt;br&gt;list_events ในช่วงเวลาทำงาน (ค่าเริ่ม 09:00–18:00)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="234" width="300" height="80" as="geometry"/></mxCell><mxCell id="sk-planning-and-time-blocking-R2" value="&lt;b&gt;2 อ่านงาน&lt;/b&gt;&lt;br&gt;ClickUp To Do / In Progress ที่ครบกำหนดวันนี้หรือเลยแล้ว" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="374" width="300" height="80" as="geometry"/></mxCell><mxCell id="sk-planning-and-time-blocking-R3" value="&lt;b&gt;3 reconcile block เดิมกับสถานะงาน&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="514" width="300" height="56" as="geometry"/></mxCell><mxCell id="sk-planning-and-time-blocking-CP" value="&lt;b&gt;4 คำนวณ chronos.py plan&lt;/b&gt;&lt;br&gt;เวลาว่าง · demand · load · block ที่เสนอ · ส่วนที่ไม่พอดี" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="630" width="300" height="80" as="geometry"/></mxCell><mxCell id="sk-planning-and-time-blocking-PK" value="ลำดับการวาง: เลยกำหนด/วันนี้ → priority → due ใกล้ → estimate เล็ก&lt;br&gt;block ≥ 25 นาที · buffer หลังประชุม" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="770" width="300" height="80" as="geometry"/></mxCell><mxCell id="sk-planning-and-time-blocking-LD" value="load &amp;gt; 1.0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="910" width="330" height="100" as="geometry"/></mxCell><mxCell id="sk-planning-and-time-blocking-LD-R" value="แสดงงานที่ไม่พอดี ถามว่าจะตัด / มอบ / เลื่อน&lt;br&gt;ห้ามลด estimate เอง" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="929" width="300" height="62" as="geometry"/></mxCell><mxCell id="sk-planning-and-time-blocking-CF" value="เวลาชนกัน?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="1070" width="330" height="100" as="geometry"/></mxCell><mxCell id="sk-planning-and-time-blocking-CF-R" value="นัดชนนัด → ผู้ใช้เลือก&lt;br&gt;block ชนนัด → ย้าย block&lt;br&gt;ไม่ย้ายนัดที่มีผู้เข้าร่วม" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="1080" width="300" height="80" as="geometry"/></mxCell><mxCell id="sk-planning-and-time-blocking-PR" value="&lt;b&gt;5 เสนอ&lt;/b&gt;&lt;br&gt;นัด = แถวคงที่ · block = แถวเสนอ · overflow พร้อมทางเลือก" style="shape=document;size=0.15;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#e1d5e7;strokeColor=#9673a6;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="1230" width="300" height="94" as="geometry"/></mxCell><mxCell id="sk-planning-and-time-blocking-OK" value="ผู้ใช้ตอบ yes?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="1384" width="330" height="100" as="geometry"/></mxCell><mxCell id="sk-planning-and-time-blocking-WR" value="&lt;b&gt;6 เขียน focus block + marker&lt;/b&gt;&lt;br&gt;อัปเดตคำอธิบายงานด้วยเวลาของ block" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="1544" width="300" height="62" as="geometry"/></mxCell><mxCell id="sk-planning-and-time-blocking-EOD" value="สิ้นวัน: block ผ่านไป&lt;br&gt;แต่งานยังไม่เสร็จ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="1666" width="330" height="100" as="geometry"/></mxCell><mxCell id="sk-planning-and-time-blocking-END" value="จบ" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="1826" width="260" height="60" as="geometry"/></mxCell><mxCell id="sk-planning-and-time-blocking-note" value="&lt;b&gt;load = demand ÷ free&lt;/b&gt;&lt;br&gt;≤ 0.7 พอดี มีที่ว่าง&lt;br&gt;0.7–1.0 ตึง บอกสิ่งที่จะหลุดก่อน&lt;br&gt;&amp;gt; 1.0 ล้น ถามว่าจะตัด/มอบ/เลื่อน&lt;br&gt;&lt;br&gt;&lt;b&gt;อย่า&lt;/b&gt;&lt;br&gt;เติมเต็มทุกนาที (หยุดที่ ~0.8)&lt;br&gt;สร้าง block ก่อนถาม" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=10;spacingRight=6;fontColor=#333333;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1225" y="110" width="320" height="170" as="geometry"/></mxCell><mxCell id="sk-planning-and-time-blocking-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-planning-and-time-blocking-S" target="sk-planning-and-time-blocking-R1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sk-planning-and-time-blocking-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-planning-and-time-blocking-R1" target="sk-planning-and-time-blocking-R2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sk-planning-and-time-blocking-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-planning-and-time-blocking-R2" target="sk-planning-and-time-blocking-R3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sk-planning-and-time-blocking-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-planning-and-time-blocking-R3" target="sk-planning-and-time-blocking-CP"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sk-planning-and-time-blocking-e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-planning-and-time-blocking-CP" target="sk-planning-and-time-blocking-PK"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sk-planning-and-time-blocking-e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0.5;exitY=1;exitDx=