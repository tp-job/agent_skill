<mxfile host="Electron" agent="agent-skill flowcharts" version="24.0.0"><diagram id="p0" name="1 ภาพรวม: วงจรจัดการเวลาและงาน"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p0-title" value="&lt;b style=&quot;font-size:24px&quot;&gt;chronos-artemis — Google Calendar + ClickUp&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#555555&quot;&gt;รวบรวม → จำแนก → ส่งไปที่ → อ่านก่อนเขียน → วางแผน → ยืนยัน → เขียน → ติดตาม → ทบทวน&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="69" y="10" width="1314" height="70" as="geometry"/></mxCell><mxCell id="p0-S" value="เริ่ม: ผู้ใช้พูดเรื่องเวลา/งาน&lt;br&gt;'วางแผนวันนี้', 'งานนี้เสร็จแล้ว'" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="480" y="117" width="280" height="66" as="geometry"/></mxCell><mxCell id="p0-D1" value="แค่ดูข้อมูลครั้งเดียว?&lt;br&gt;('นัดบ่าย 3 กี่โมง')" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="257" width="250" height="116" as="geometry"/></mxCell><mxCell id="p0-Q" value="อ่านปฏิทินแล้วตอบเลย" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1085" y="282" width="230" height="66" as="geometry"/></mxCell><mxCell id="p0-D2" value="Calendar และ ClickUp&lt;br&gt;พร้อมใช้ไหม?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="422" width="250" height="116" as="geometry"/></mxCell><mxCell id="p0-CONN" value="deferred → โหลด tool&lt;br&gt;ต้อง auth → บอกผู้ใช้ไปอนุมัติ&lt;br&gt;ทำส่วนที่ทำได้ แจ้งสิ่งที่ข้าม" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="205" y="435" width="250" height="90" as="geometry"/></mxCell><mxCell id="p0-C1" value="&lt;b&gt;1 รวบรวม&lt;/b&gt;&lt;br&gt;จดทุกอย่างที่ผู้ใช้พูดแบบดิบ&lt;br&gt;ยังไม่แตะเครื่องมือ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="490" y="600" width="260" height="90" as="geometry"/></mxCell><mxCell id="p0-C2" value="&lt;b&gt;2 จำแนก&lt;/b&gt;&lt;br&gt;นัด / งาน / กิจกรรม&lt;br&gt;(ดูหน้า 2)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="490" y="765" width="260" height="90" as="geometry"/></mxCell><mxCell id="p0-C3" value="&lt;b&gt;3 ส่งไปที่ไหน?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="917" width="250" height="116" as="geometry"/></mxCell><mxCell id="p0-EV" value="&lt;b&gt;นัด&lt;/b&gt; → Google Calendar event&lt;br&gt;เวลาเริ่ม–จบ&lt;br&gt;(ISO 8601 + timezone)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="205" y="1095" width="250" height="90" as="geometry"/></mxCell><mxCell id="p0-DL" value="รู้ว่าจะใส่&lt;br&gt;ClickUp list ไหน?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="1082" width="250" height="116" as="geometry"/></mxCell><mxCell id="p0-ASKL" value="ถามผู้ใช้&lt;br&gt;แล้วจำไว้ทั้งเซสชัน" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="858" y="1100" width="220" height="80" as="geometry"/></mxCell><mxCell id="p0-ACT" value="&lt;b&gt;กิจกรรม&lt;/b&gt;&lt;br&gt;block ในปฏิทิน (แผน)&lt;br&gt;+ time entry ใน ClickUp (จริง)&lt;br&gt;วัดเป็นนาที / ความถี่" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1133" y="1085" width="250" height="110" as="geometry"/></mxCell><mxCell id="p0-TASK" value="&lt;b&gt;งาน&lt;/b&gt; → ClickUp task&lt;br&gt;due date + เวลาประเมิน&lt;br&gt;(เวลาประเมินเป็นของผู้ใช้)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="490" y="1260" width="260" height="90" as="geometry"/></mxCell><mxCell id="p0-READ" value="&lt;b&gt;4 อ่านก่อนเขียน&lt;/b&gt;&lt;br&gt;ดูปฏิทินวันนี้ + งานที่เปิดอยู่&lt;br&gt;ค้นหาของซ้ำก่อนสร้าง" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="485" y="1425" width="270" height="90" as="geometry"/></mxCell><mxCell id="p0-PLAN" value="&lt;b&gt;5 วางแผน&lt;/b&gt;&lt;br&gt;หาช่องว่าง → วางงานลงช่อง (time-block)&lt;br&gt;เรียงตาม due date และความสำคัญ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="470" y="1590" width="300" height="90" as="geometry"/></mxCell><mxCell id="p0-DOV" value="งานล้น หรือ&lt;br&gt;เวลาชนกัน?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="1742" width="250" height="116" as="geometry"/></mxCell><mxCell id="p0-OV" value="แสดงตัวเลขให้ผู้ใช้เลือก&lt;br&gt;ชั่วโมงว่าง vs ชั่วโมงงาน&lt;br&gt;เลื่อน / ตัด / ขอเลื่อน due" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="896" y="1755" width="260" height="90" as="geometry"/></mxCell><mxCell id="p0-CONF" value="&lt;b&gt;6 ยืนยัน&lt;/b&gt;&lt;br&gt;แสดงตาราง: สร้าง / ย้าย / แก้ อะไรบ้าง" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="475" y="1925" width="290" height="80" as="geometry"/></mxCell><mxCell id="p0-DY" value="ผู้ใช้ตอบ yes?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="2072" width="250" height="116" as="geometry"/></mxCell><mxCell id="p0-ADJ" value="ปรับแผน&lt;br&gt;ตามที่ผู้ใช้บอก" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="215" y="2090" width="230" height="80" as="geometry"/></mxCell><mxCell id="p0-DATT" value="มีผู้เข้าร่วม?&lt;br&gt;(จะส่งอีเมลแจ้งคนอื่น)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="2237" width="250" height="116" as="geometry"/></mxCell><mxCell id="p0-ATT" value="ขอ yes แยกอีกครั้ง&lt;br&gt;สำหรับรายการนั้น" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="911" y="2255" width="230" height="80" as="geometry"/></mxCell><mxCell id="p0-NN" value="ไม่มีผู้เข้าร่วม&lt;br&gt;→ notificationLevel: NONE&lt;br&gt;(ไม่ส่งอีเมลรบกวน)" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=10;spacingRight=6;fontColor=#333333;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="949" y="2422" width="240" height="90" as="geometry"/></mxCell><mxCell id="p0-WRITE" value="&lt;b&gt;7 เขียนลงระบบ&lt;/b&gt;&lt;br&gt;สร้าง/อัปเดต · ลิงก์ block ↔ task" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="480" y="2427" width="280" height="80" as="geometry"/></mxCell><mxCell id="p0-NODEL" value="ห้ามลบ&lt;br&gt;ยกเลิก / ปฏิเสธ / เลื่อนแทน&lt;br&gt;(ลบต้องยืนยันรายการนั้นชัดๆ)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="190" y="2422" width="250" height="90" as="geometry"/></mxCell><mxCell id="p0-REP" value="รายงานว่าอะไรสำเร็จ อะไรล้มเหลว&lt;br&gt;(เฉพาะที่เห็นผลจริง)" style="shape=document;size=0.15;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#e1d5e7;strokeColor=#9673a6;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="475" y="2584" width="290" height="96" as="geometry"/></mxCell><mxCell id="p0-TRACK" value="&lt;b&gt;8 ติดตาม&lt;/b&gt;&lt;br&gt;ย้ายสถานะงาน · จับเวลา&lt;br&gt;(ดูหน้า 2)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="490" y="2752" width="260" height="90" as="geometry"/></mxCell><mxCell id="p0-REV" value="&lt;b&gt;9 ทบทวน&lt;/b&gt;&lt;br&gt;รายวัน: วันนี้มีอะไร&lt;br&gt;รายสัปดาห์: เสร็จอะไร หลุดอะไร · สถิติกิจกรรม" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="460" y="2912" width="320" height="100" as="geometry"/></mxCell><mxCell id="p0-DN" value="มีรายการใหม่&lt;br&gt;หรือวันใหม่?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="3077" width="250" height="116" as="geometry"/></mxCell><mxCell id="p0-E" value="จบรอบนี้" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="505" y="3267" width="230" height="66" as="geometry"/></mxCell><mxCell id="p0-e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;" edge="1" parent="1" source="p0-S" target="p0-D1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p0-e1" value="ใช่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0-D1" target="p0-Q"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p0-e2" value="ไม่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;" edge="1" parent="1" source="p0-D1" target="p0-D2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p0-e3" value="ไม่พร้อม" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0-D2" target="p0-CONN"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p0-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0-CONN" target="p0-C1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p0-e5" value="พร้อม" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;" edge="1" parent="1" source="p0-D2" target="p0-C1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p0-e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;" edge="1" parent="1" source="p0-C1" target="p0-C2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p0-e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;" edge="1" parent="1" source="p0-C2" target="p0-C3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p0-e8" value="นัด" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0-C3" target="p0-EV"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p0-e9" value="งาน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;font