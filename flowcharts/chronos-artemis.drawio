oma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="234" width="300" height="98" as="geometry"/></mxCell><mxCell id="sk-clickup-RW" value="อ่าน หรือ เขียน?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="392" width="330" height="100" as="geometry"/></mxCell><mxCell id="sk-clickup-RW-R" value="filter_tasks (ไล่ทุกหน้าจน has_more = false)&lt;br&gt;search → get_task · time entries" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="401" width="300" height="82" as="geometry"/></mxCell><mxCell id="sk-clickup-BK" value="หลายงานพร้อมกัน?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="552" width="330" height="100" as="geometry"/></mxCell><mxCell id="sk-clickup-BK-R" value="get_operators → execute_operator&lt;br&gt;(ไม่วนทีละงาน)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="570" width="300" height="64" as="geometry"/></mxCell><mxCell id="sk-clickup-FW-0" value="create_task&lt;br&gt;ชื่อเป็นผลลัพธ์ · list_id · due · priority · estimate" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="62" y="738" width="230" height="80" as="geometry"/></mxCell><mxCell id="sk-clickup-FW-1" value="ใช้ชื่อ status ของ list นั้น&lt;br&gt;ไม่ใช่ป้ายกลาง" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="318" y="738" width="230" height="80" as=