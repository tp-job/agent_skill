;spacingLeft=10;spacingRight=6;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="944" y="3483" width="60" height="34" as="geometry"/></mxCell><mxCell id="p0-lgt7" value="หมายเหตุ" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1014" y="3483" width="210" height="34" as="geometry"/></mxCell><mxCell id="p0-lge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="89" y="3551" as="sourcePoint"/><mxPoint x="149" y="3551" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p0-lget0" value="เส้นทางหลัก" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="159" y="3539" width="210" height="24" as="geometry"/></mxCell><mxCell id="p0-lge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;strokeColor=#b85450;dashed=1;fontColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="374" y="3551" as="sourcePoint"/><mxPoint x="434" y="3551" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p0-lget1" value="วนกลับ (loop)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="444" y="3539" width="210" height="24" as="geometry"/></mxCell><mxCell id="p0-lge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;strokeColor=#999999;dashed=1;dashPattern=1 3;endArrow=open;endFill=0;fontColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="659" y="3551" as="sourcePoint"/><mxPoint x="719" y="3551" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p0-lget2" value="อ้างอิง / ใช้ประกอบ" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="729" y="3539" width="210" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="2 จำแนกรายการ และสถานะงาน"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1-title" value="&lt;b style=&quot;font-size:24px&quot;&gt;chronos-artemis › item-classification + task-status-model&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#555555&quot;&gt;ผิดที่พบบ่อยคือ 'ใส่ผิดที่' ไม่ใช่ 'ขี้เกียจ' — จำแนกก่อน แล้วค่อยส่งไปเครื่องมือที่เป็นเจ้าของ&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="69" y="10" width="1260" height="70" as="geometry"/></mxCell><mxCell id="p1-z0" value="ส่วน A: รายการนี้คืออะไร" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=#f3f8ff;strokeColor=#9fb7d8;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontColor=#555555;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="54" y="225" width="1377" height="1057" as="geometry"/></mxCell><mxCell id="p1-z1" value="ส่วน B: สถานะงาน 3 ระดับ (ไม่ว่า list จะตั้งชื่อสถานะว่าอะไร)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=#fffaf0;strokeColor=#e0c080;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontColor=#555555;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="54" y="1297" width="1377" height="862" as="geometry"/></mxCell><mxCell id="p1-S" value="รายการใหม่&lt;br&gt;(จากขั้นรวบรวม)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="505" y="117" width="230" height="66" as="geometry"/></mxCell><mxCell id="p1-DH" value="ในประโยคเดียว&lt;br&gt;มีหลายอย่างไหม?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="257" width="250" height="116" as="geometry"/></mxCell><mxCell id="p1-SPLIT" value="แยกเป็นหลายรายการ&lt;br&gt;แล้วจำแนกทีละชิ้น" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="906" y="275" width="240" height="80" as="geometry"/></mxCell><mxCell id="p1-HYB" value="&lt;b&gt;ตัวอย่างรายการผสม&lt;/b&gt;&lt;br&gt;'เตรียมประชุมบอร์ด อังคาร 10:00'&lt;br&gt;= นัด (ประชุม) + งาน (เตรียม, due ก่อน 10:00)&lt;br&gt;'ทำวิทยานิพนธ์ 2 ชม.วันนี้'&lt;br&gt;= block กิจกรรม ลิงก์กับงานย่อยถัดไป" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=10;spacingRight=6;fontColor=#333333;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="962" y="447" width="330" height="140" as="geometry"/></mxCell><mxCell id="p1-Q1" value="ผูกกับเวลาที่คนอื่น/สิ่งอื่นกำหนด?&lt;br&gt;(คน สถานที่ เที่ยวบิน คลาส)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="475" y="435" width="290" height="120" as="geometry"/></mxCell><mxCell id="p1-SCH" value="&lt;b&gt;นัด (Schedule)&lt;/b&gt;&lt;br&gt;→ Google Calendar event&lt;br&gt;วัดด้วย: ไปหรือไม่ไป" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="190" y="450" width="250" height="90" as="geometry"/></mxCell><mxCell id="p1-Q2" value="จบด้วยผลลัพธ์&lt;br&gt;ที่ติ๊กว่าเสร็จได้?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="624" width="250" height="116" as="geometry"/></mxCell><mxCell id="p1-TSK" value="&lt;b&gt;งาน (Task)&lt;/b&gt;&lt;br&gt;→ ClickUp task&lt;br&gt;เวลาที่พูดถึง = due date ไม่ใช่นัด" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="190" y="637" width="250" height="90" as="geometry"/></mxCell><mxCell id="p1-Q3" value="เป็นเวลาที่ลงทุนกับสิ่งต่อเนื่อง&lt;br&gt;ที่ไม่มีวันเสร็จ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="475" y="795" width="290" height="120" as="geometry"/></mxCell><mxCell id="p1-ACT" value="&lt;b&gt;กิจกรรม (Activity)&lt;/b&gt;&lt;br&gt;→ block ในปฏิทิน + บันทึกเวลา&lt;br&gt;วัดด้วย: นาที / ความถี่" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="190" y="810" width="250" height="90" as="geometry"/></mxCell><mxCell id="p1-ASK" value="ยังไม่แน่ใจ&lt;br&gt;ถามผู้ใช้ 1 คำถามสั้นๆ" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="500" y="987" width="240" height="80" as="geometry"/></mxCell><mxCell id="p1-DANS" value="ผู้ใช้ตอบไหม?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="1127" width="250" height="116" as="geometry"/></mxCell><mxCell id="p1-DEF" value="ถือเป็น 'งาน' ไว้ก่อน&lt;br&gt;(นัดผิดจะกินเวลา&lt;br&gt;และแจ้งคนอื่นโดยไม่ตั้งใจ)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="901" y="1140" width="250" height="90" as="geometry"/></mxCell><mxCell id="p1-MAP" value="อ่านชื่อสถานะของ list นั้น&lt;br&gt;แปลงเป็น 3 ระดับ&lt;br&gt;(open / custom / done / closed)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="485" y="1357" width="270" height="90" as="geometry"/></mxCell><mxCell id="p1-TODO" value="To Do&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;เพิ่งเก็บ · ยังไม่เริ่ม · เปิดใหม่&lt;/span&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="205" y="1557" width="220" height="80" as="geometry"/></mxCell><mxCell id="p1-INP" value="In Progress&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;เริ่มทำแล้ว&lt;/span&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="520" y="1562" width="200" height="70" as="geometry"/></mxCell><mxCell id="p1-DFIN" value="ผู้ใช้ยืนยันเองว่า&lt;br&gt;ผลงานมีอยู่จริง?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="809" y="1539" width="230" height="116" as="geometry"/></mxCell><mxCell id="p1-DONE" value="Completed&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;เสร็จแล้ว&lt;/span&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1129" y="1562" width="200" height="70" as="geometry"/></mxCell><mxCell id="p1-FLAG" value="