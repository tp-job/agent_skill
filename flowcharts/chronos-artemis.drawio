" edge="1" parent="1" source="sk-planning-and-time-blocking-OK" target="sk-planning-and-time-blocking-WR"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sk-planning-and-time-blocking-e15" value="ไม่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;strokeColor=#b85450;dashed=1;fontColor=#b85450;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-planning-and-time-blocking-OK" target="sk-planning-and-time-blocking-CP"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="355" y="1434"/><mxPoint x="355" y="670"/></Array></mxGeometry></mxCell><mxCell id="sk-planning-and-time-blocking-e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-planning-and-time-blocking-WR" target="sk-planning-and-time-blocking-EOD"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sk-planning-and-time-blocking-e17" value="ไม่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-planning-and-time-blocking-EOD" target="sk-planning-and-time-blocking-END"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sk-planning-and-time-blocking-e18" value="มี → ถาม เสร็จ/คืบ/ยัง แล้ววางใหม่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;strokeColor=#b85450;dashed=1;fontColor=#b85450;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-planning-and-time-blocking-EOD" target="sk-planning-and-time-blocking-R2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="325" y="1716"/><mxPoint x="325" y="414"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="sk-google-calendar" name="5 google-calendar: อ่านและเขียนปฏิทิน"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sk-google-calendar-title" value="&lt;b style=&quot;font-size:24px&quot;&gt;Google Calendar — อ่านและเขียน event อย่างปลอดภัย&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#555555&quot;&gt;time zone เดียวต่อเซสชัน · ค้นก่อนสร้าง · due date ไม่ใช่ event · อะไรที่แจ้งคนอื่นต้องได้ yes แยก&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="62.5" y="10" width="1400" height="70" as="geometry"/></mxCell><mxCell id="sk-google-calendar-S" value="เริ่ม&lt;br&gt;ต้องอ่าน / เขียนปฏิทิน" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="110" width="260" height="64" as="geometry"/></mxCell><mxCell id="sk-google-calendar-TZ" value="อ่าน time zone ของปฏิทินหลัก&lt;br&gt;1 ครั้งต่อเซสชัน" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="234" width="300" height="62" as="geometry"/></mxCell><mxCell id="sk-google-calendar-RW" value="อ่าน หรือ เขียน?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="356" width="330" height="100" as="geometry"/></mxCell><mxCell id="sk-google-calendar-RW-R" value="list_events (วัน/สัปดาห์)&lt;br&gt;search_events (หาก่อนสร้าง)&lt;br&gt;suggest_time (หาเวลาว่างร่วมกับคนอื่น)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="365" width="300" height="82" as="geometry"/></mxCell><mxCell id="sk-google-calendar-DU" value="เป็น due date&lt;br&gt;ของงาน?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="516" width="330" height="100" as="geometry"/></mxCell><mxCell id="sk-google-calendar-DU-R" value="ไม่สร้าง event&lt;br&gt;due ใน ClickUp + focus block ก่อนกำหนด" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="534" width="300" height="64" as="geometry"/></mxCell><mxCell id="sk-google-calendar-SR" value="ค้นของเดิมก่อน (กันซ้ำ)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="676" width="300" height="56" as="geometry"/></mxCell><mxCell id="sk-google-calendar-FT-0" value="DEFAULT · busy" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="62" y="818" width="230" height="62" as="geometry"/></mxCell><mxCell id="sk-google-calendar-FT-1" value="OUT_OF_OFFICE&lt;br&gt;(ไม่ all-day)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="318" y="818" width="230" height="62" as="geometry"/></mxCell><mxCell id="sk-google-calendar-FT-2" value="FOCUS_TIME&lt;br&gt;+ ลิงก์งาน" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="572" y="818" width="230" height="62" as="geometry"/></mxCell><mxCell id="sk-google-calendar-FT-3" value="RRULE&lt;br&gt;ยืนยัน COUNT / UNTIL" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="828" y="818" width="230" height="62" as="geometry"/></mxCell><mxCell id="sk-google-calendar-ISO" value="เวลา ISO 8601 พร้อม offset เสมอ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="940" width="300" height="56" as="geometry"/></mxCell><mxCell id="sk-google-calendar-AT" value="มีผู้เข้าร่วม / ตอบรับเชิญ /&lt;br&gt;ลบ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="1056" width="330" height="100" as="geometry"/></mxCell><mxCell id="sk-google-calendar-AT-R" value="ขอ yes แยก — ส่งอีเมลถึงคนอื่น&lt;br&gt;ลบเมื่อสั่งชัดเท่านั้น (เลื่อน/ปฏิเสธดีกว่า)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="1075" width="300" height="62" as="geometry"/></mxCell><mxCell id="sk-google-calendar-END" value="create_event / update_event&lt;br&gt;แล้วรายงานผลจริง" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="1216" width="260" height="64" as="geometry"/></mxCell><mxCell id="sk-google-calendar-note" value="&lt;b&gt;BAD / BETTER&lt;/b&gt;&lt;br&gt;&#x27;Report due&#x27; เป็น event ศุกร์ 17:00&lt;br&gt;→ due ใน ClickUp + focus block วันพฤหัส&lt;br&gt;&lt;br&gt;startTime ไม่มี offset&lt;br&gt;→ 2026-09-29T14:00:00+07:00&lt;br&gt;&lt;br&gt;ลบ focus block ที่พลาด&lt;br&gt;→ เก็บไว้เป็นประวัติ หรือย้าย" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=10;spacingRight=6;fontColor=#333333;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1225" y="110" width="320" height="188" as="geometry"/></mxCell><mxCell id="sk-google-calendar-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-google-calendar-S" target="sk-google-calendar-TZ"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sk-google-calendar-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-google-calendar-TZ" target="sk-google-calendar-RW"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sk-google-calendar-e3" value="เขียน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-google-calendar-RW" target="sk-google-calendar-DU"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sk-google-calendar-e4" value="อ่าน" style="edgeStyle=orthogonalEdgeStyle;round