y relative="1" as="geometry"><Array as="points"><mxPoint x="325" y="1302"/><mxPoint x="325" y="425"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="sk-github-report" name="6 github-report: รายงานงานจาก GitHub"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sk-github-report-title" value="&lt;b style=&quot;font-size:24px&quot;&gt;github-report — จาก commit / PR / issue สู่รายงาน .md&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#555555&quot;&gt;ตรวจข้อมูลจริง → ตรึงขอบเขต → เก็บ → จัดกลุ่ม → เขียน → กระทบยอด&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395.0" y="10" width="1400" height="70" as="geometry"/></mxCell><mxCell id="sk-github-report-S" value="เริ่ม&lt;br&gt;ขอสรุปงานที่ส่งแล้ว / ตั้งกฎ commit" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="110" width="260" height="64" as="geometry"/></mxCell><mxCell id="sk-github-report-D0" value="ขอตั้งกฎ&lt;br&gt;ไม่ใช่รายงาน?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="234" width="330" height="100" as="geometry"/></mxCell><mxCell id="sk-github-report-D0-R" value="Conventions: commit · PR · issue&lt;br&gt;(ใช้กับงานใหม่ ไม่แก้ประวัติเก่า)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="252" width="300" height="64" as="geometry"/></mxCell><mxCell id="sk-github-report-S0" value="&lt;b&gt;0 ตรวจข้อมูลจริง&lt;/b&gt;&lt;br&gt;git log --oneline -30 · gh auth status" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="394" width="300" height="62" as="geometry"/></mxCell><mxCell id="sk-github-report-D1" value="history ตาม&lt;br&gt;convention?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="516" width="330" height="100" as="geometry"/></mxCell><mxCell id="sk-github-report-D1-R" value="จัดกลุ่มตาม path / ชื่อ PR + เตือนว่าเป็นการอนุมาน&lt;br&gt;ไม่มี gh → รายงาน commit อย่างเดียว (บอกข้อจำกัด)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="517" width="300" height="98" as="geometry"/></mxCell><mxCell id="sk-github-report-S1" value="&lt;b&gt;1 ตรึงขอบเขต&lt;/b&gt;&lt;br&gt;ช่วงเวลา (แปลงเป็นวันที่จริง) · repo/branch · แกนจัดกลุ่ม · ผู้อ่าน" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="676" width="300" height="80" as="geometry"/></mxCell><mxCell id="sk-github-report-S2" value="&lt;b&gt;2 เก็บข้อมูลตามลำดับ&lt;/b&gt;&lt;br&gt;PR ที่ merge → issue ที่ปิด → commit&lt;br&gt;(เก็บ raw ไว้ใน scratchpad)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="816" width="300" height="80" as="geometry"/></mxCell><mxCell id="sk-github-report-S3" value="&lt;b&gt;3 จัดกลุ่ม + ประเภท&lt;/b&gt;&lt;br&gt;label/milestone → scope ใน commit → ชื่อ PR/issue → path หลัก → Other&lt;br&gt;ตัด merge เปล่า · revert คู่ · lockfile" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="956" width="300" height="98" as="geometry"/></mxCell><mxCell id="sk-github-report-S4" value="&lt;b&gt;4 เขียน reports/&amp;lt;YYYY-MM-DD&amp;gt;-&amp;lt;scope&amp;gt;.md&lt;/b&gt;&lt;br&gt;เริ่มจาก assets/sprint-report.md" style="shape=document;size=0.15;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#e1d5e7;strokeColor=#9673a6;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="1114" width="300" height="76" as="geometry"/></mxCell><mxCell id="sk-github-report-D5" value="5 กระทบยอดตรงหมด?&lt;br&gt;ยอดสรุป = ยอดในหมวด · ref มาจาก step 2 · ช่วงวันตรง" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="1250" width="330" height="118" as="geometry"/></mxCell><mxCell id="sk-github-report-END" value="ส่งรายงาน" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="1428" width="260" height="60" as="geometry"/></mxCell><mxCell id="sk-github-report-note" value="&lt;b&gt;กติกาที่ไม่ต่อรอง&lt;/b&gt;&lt;br&gt;• ทุกข้ออ้างมี #123 / PR / SHA&lt;br&gt;• ผลลัพธ์ ไม่ใช่กิจกรรม&lt;br&gt;• บอกสิ่งที่ไม่ได้ส่ง&lt;br&gt;• ไม่แต่งตัวเลข velocity / coverage" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=10;spacingRight=6;fontColor=#333333;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1225" y="110" width="320" height="116" as="geometry"/></mxCell><mxCell id="sk-github-report-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" ed