=13;" vertex="1" parent="1"><mxGeometry x="54" y="2332" width="1363" height="592" as="geometry"/></mxCell><mxCell id="p1-S" value="รับเป้าหมายที่เขียนแล้ว&lt;br&gt;(brief หรือสัญญาจากโค้ดเดิม)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="490" y="117" width="260" height="66" as="geometry"/></mxCell><mxCell id="p1-G1" value="&lt;b&gt;Gate 1 ความต้องการ&lt;/b&gt;&lt;br&gt;ปัญหา · เกณฑ์ผ่านมีเลขกำกับ&lt;br&gt;· สิ่งที่ไม่ทำ · edge case&lt;br&gt;→ build-spec.md" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="490" y="265" width="260" height="100" as="geometry"/></mxCell><mxCell id="p1-G2" value="&lt;b&gt;Gate 2 ออกแบบ&lt;/b&gt;&lt;br&gt;logic flow · สัญญาข้อมูล · ตอนพัง · สถานะ UI&lt;br&gt;แตกงานเป็น phase → feature-list.json" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="475" y="445" width="290" height="100" as="geometry"/></mxCell><mxCell id="p1-H" value="&lt;b&gt;ไฟล์สถานะบนดิสก์&lt;/b&gt;&lt;br&gt;build-spec.md · feature-list.json&lt;br&gt;progress.md · init.sh&lt;br&gt;+ ประวัติ git" style="shape=document;size=0.15;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#e1d5e7;strokeColor=#9673a6;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="978" y="350" width="270" height="110" as="geometry"/></mxCell><mxCell id="p1-DSZ" value="งานย่อยเกิน ~10 ชิ้น&lt;br&gt;หรือหลายเซสชัน?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="729" width="250" height="116" as="geometry"/></mxCell><mxCell id="p1-SK" value="ข้ามวง phase&lt;br&gt;ใช้ branch เดียว" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="215" y="747" width="230" height="80" as="geometry"/></mxCell><mxCell id="p1-GRP" value="&lt;b&gt;จัดกลุ่มตาม 'สัญญา'&lt;/b&gt;&lt;br&gt;งานที่อ่านผลของอีกงาน&lt;br&gt;(field, state, token, route)&lt;br&gt;ต้องอยู่ phase เดียวกัน&lt;br&gt;'เป็นเรื่องสีเหมือนกัน' ≠ เกี่ยวกัน" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=10;spacingRight=6;fontColor=#333333;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="978" y="775" width="270" height="130" as="geometry"/></mxCell><mxCell id="p1-P1" value="เปิด branch ใหม่ของ phase" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="505" y="912" width="230" height="80" as="geometry"/></mxCell><mxCell id="p1-I1" value="ดูเทสต์ที่เกี่ยวข้อง&lt;br&gt;→ เลือกงานถัดไปใน ledger" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="505" y="1070" width="230" height="80" as="geometry"/></mxCell><mxCell id="p1-I2" value="ลงมือทำ (implement)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="505" y="1227" width="230" height="80" as="geometry"/></mxCell><mxCell id="p1-I3" value="ผ่านขั้นตอนตรวจของงานนี้?&lt;br&gt;(ผ่าน interface ที่ผู้ใช้แตะจริง)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="485" y="1372" width="270" height="120" as="geometry"/></mxCell><mxCell id="p1-BLK" value="&lt;b&gt;รันตรวจไม่ได้&lt;/b&gt;&lt;br&gt;บันทึก blocked + เหตุผล&lt;br&gt;+ เช็กใหม่เมื่อไร&lt;br&gt;(ห้ามใส่ true)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="210" y="1382" width="240" height="100" as="geometry"/></mxCell><mxCell id="p1-DF2" value="พลาดงานนี้&lt;br&gt;ครบ 2 ครั้ง?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="843" y="1374" width="250" height="116" as="geometry"/></mxCell><mxCell id="p1-DEEP" value="คิดลึก: ทบทวน&lt;br&gt;การแตกงานและการออกแบบ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1143" y="1227" width="230" height="80" as="geometry"/></mxCell><mxCell id="p1-I4" value="refactor เฉพาะส่วนที่แตะ&lt;br&gt;(ไม่ copy utility ซ้ำ)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="505" y="1572" width="230" height="80" as="geometry"/></mxCell><mxCell id="p1-I5" value="อัปเดต ledger&lt;br&gt;(แก้ได้แค่ passes กับ notes)" style="shape=document;size=0.15;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#e1d5e7;strokeColor=#9673a6;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="1729" width="250" height="96" as="geometry"/></mxCell><mxCell id="p1-I6" value="commit เรื่องเดียว&lt;br&gt;stage เฉพาะไฟล์ที่แก้ (ไม่ใช้ -A)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="505" y="1902" width="230" height="80" as="geometry"/></mxCell><mxCell id="p1-DM" value="ยังมีงาน&lt;br&gt;ใน phase นี้?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="2049" width="250" height="116" as="geometry"/></mxCell><mxCell id="p1-PC" value="ตรวจท้าย phase&lt;br&gt;เทสต์ทั้งชุดเขียว&lt;br&gt;+ close-out ที่จริง" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="853" y="2062" width="230" height="90" as="geometry"/></mxCell><mxCell id="p1-M" value="merge&lt;br&gt;แล้วจด sha ลง progress.md" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1148" y="2067" width="220" height="80" as="geometry"/></mxCell><mxCell id="p1-DPH" value="ยังมี phase ถัดไป?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1148" y="2207" width="220" height="100" as="geometry"/></mxCell><mxCell id="p1-BUG1" value="ผู้ใช้แจ้งบักกลางทาง" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1003" y="1707" width="220" height="66" as="geometry"/></mxCell><mxCell id="p1-BUG2" value="ถามให้ครบ: ทำอะไร&lt;br&gt;คาดว่าจะเกิดอะไร · เกิดอะไรจริง" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="988" y="1850" width="250" height="80" as="geometry"/></mxCell><mxCell id="p1-G4" value="&lt;b&gt;Gate 4 Integration QA&lt;/b&gt;&lt;br&gt;คู่ฟีเจอร์ที่พังเมื่อรวม · user journey เต็ม&lt;br&gt;· ฟีเจอร์เก่าที่ไม่ได้ตรวจซ้ำ · โหลด · รายการ blocked" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="455" y="2395" width="330" height="100" as="geometry"/></mxCell><mxCell id="p1-G5" value="&lt;b&gt;Gate 5 UAT&lt;/b&gt;&lt;br&gt;สคริปต์จาก use case → ผู้ใช้เซ็นรับ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="475" y="2570" width="290" height="80" as="geometry"/></mxCell><mxCell id="p1-G6" value="&lt;b&gt;Gate 6 Deploy&lt;/b&gt;&lt;br&gt;แผน rollback · smoke test · คนเฝ้าระบบ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="475" y="2727" width="290" height="80" as="geometry"/></mxCell><mxCell id="p1-E" value="ส่งงานแล้ว → ไปเสา Format&lt;br&gt;(รายงานจากข้อมูลจริง)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="490" y="2952" width="260" height="66" as="geometry"/></mxCell><mxCell id="p1-NS" value="&lt;b&gt;ก่อนจบเซสชัน / ก่อน compaction&lt;br&gt;/ ก่อนส่งงานให้ subagent&lt;/b&gt;&lt;br&gt;commit + เขียน progress.md เสมอ&lt;br&gt;สิ่งที่อยู่แค่ในแชท ไม่นับเป็นสถานะ" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=10;spacingRight=6;fontColor=#333333;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="977" y="2550" width="300" height="120" as="geometry"/></mxCell><mxCell id="p1-e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;" edge="1" parent="1" source="p1-S" target="p1-G1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;