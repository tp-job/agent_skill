<mxfile host="Electron" agent="agent-skill flowcharts" version="24.0.0"><diagram id="p0" name="1 ภาพรวม: เลือกเส้นทางงาน"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p0-title" value="&lt;b style=&quot;font-size:24px&quot;&gt;promethean-parthenon — ศูนย์กลางงานวิศวกรรม&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#555555&quot;&gt;รับคำขอ → เลือกผู้เชี่ยวชาญหรือเสาหลัก Role · Task · Format → สร้าง → ตรวจ → บันทึก&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="69" y="10" width="1401" height="70" as="geometry"/></mxCell><mxCell id="p0-S" value="เริ่ม&lt;br&gt;ผู้ใช้ส่งคำขอมา" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="505" y="117" width="230" height="66" as="geometry"/></mxCell><mxCell id="p0-D1" value="คำขอบอกชัดว่าเป็น&lt;br&gt;งานของผู้เชี่ยวชาญไหม?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="242" width="250" height="116" as="geometry"/></mxCell><mxCell id="p0-SP" value="&lt;b&gt;เปิดผู้เชี่ยวชาญทันที&lt;/b&gt;&lt;br&gt;• บัก / error / ช้า → debug-master&lt;br&gt;• ความปลอดภัย / auth / API key → owasp-top-10-2025&lt;br&gt;• ธีม / dark mode / คอนทราสต์ → ui-checker&lt;br&gt;• วางไฟล์ / ตั้งชื่อ → project-file-structure&lt;br&gt;• เขียนหรือแก้ skill → skill-creator&lt;br&gt;• รายงานงานที่ส่งแล้ว → github-report" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1035" y="252" width="330" height="170" as="geometry"/></mxCell><mxCell id="p0-ESP" value="ทำงานตาม skill นั้นจนจบ&lt;br&gt;(ไม่ต้องเดินครบทุกเสา)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1085" y="522" width="230" height="66" as="geometry"/></mxCell><mxCell id="p0-D2" value="งานเล็กและระบุครบ?&lt;br&gt;(แก้คำผิด, bump เวอร์ชัน)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="392" width="250" height="116" as="geometry"/></mxCell><mxCell id="p0-Q1" value="เขียนเป้าหมาย 1 บรรทัด&lt;br&gt;(ห้ามเป็นศูนย์บรรทัด)&lt;br&gt;แล้วลงมือเลย" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="215" y="410" width="230" height="80" as="geometry"/></mxCell><mxCell id="p0-D3" value="รู้ 'ปัญหาจริง' แล้วหรือยัง?&lt;br&gt;(มีอาการที่วัดได้)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="542" width="250" height="116" as="geometry"/></mxCell><mxCell id="p0-F" value="&lt;b&gt;ฐานราก: คิดก่อนลงมือ&lt;/b&gt;&lt;br&gt;• ตั้งโจทย์: วัด 1 ตัวเลขก่อนเดา&lt;br&gt;• สังเคราะห์: หลายแหล่ง → จุดยืนเดียว&lt;br&gt;• ถามคน: เรื่องค่านิยม/รสนิยม&lt;br&gt;  พร้อมค่าเริ่มต้นถ้าไม่มีใครตอบ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="895" y="610" width="290" height="130" as="geometry"/></mxCell><mxCell id="p0-D5" value="เป็นการเลือกระหว่าง&lt;br&gt;ทางเลือก / ตัดสินใจ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="752" width="250" height="116" as="geometry"/></mxCell><mxCell id="p0-R" value="&lt;b&gt;เสา Role&lt;/b&gt;&lt;br&gt;นั่งเก้าอี้ผู้นำ (senior-leadership-advisor)&lt;br&gt;เลือกทาง + บอก trade-off ชัด" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="895" y="840" width="290" height="90" as="geometry"/></mxCell><mxCell id="p0-D5b" value="ต้องลงมือสร้างต่อไหม?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="915" y="977" width="250" height="116" as="geometry"/></mxCell><mxCell id="p0-EDEC" value="บันทึกการตัดสินใจ&lt;br&gt;เหตุผล + เงื่อนไขที่ต้องทบทวน" style="shape=document;size=0.15;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#e1d5e7;strokeColor=#9673a6;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1220" y="1137" width="250" height="96" as="geometry"/></mxCell><mxCell id="p0-D6" value="ความต้องการ (requirements)&lt;br&gt;อยู่ที่ไหน?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="977" width="250" height="116" as="geometry"/></mxCell><mxCell id="p0-T1" value="&lt;b&gt;requirement-gathering&lt;/b&gt;&lt;br&gt;ดึง REQ-*, สัญญา API/DB&lt;br&gt;+ รายการช่องว่าง จากโค้ดเดิม" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="210" y="1155" width="240" height="90" as="geometry"/></mxCell><mxCell id="p0-T2" value="&lt;b&gt;agentic-engineering&lt;/b&gt;&lt;br&gt;brief 1 หน้า: ทำอะไร · เพื่อใคร&lt;br&gt;· ข้อจำกัด · พิสูจน์ยังไง" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="500" y="1155" width="240" height="90" as="geometry"/></mxCell><mxCell id="p0-TG" value="&lt;b&gt;เป้าหมายเขียนลงไฟล์แล้ว&lt;/b&gt;&lt;br&gt;เกณฑ์ผ่านมีตัวเลข · ขอบเขต · สิ่งที่ไม่ทำ" style="shape=document;size=0.15;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#e1d5e7;strokeColor=#9673a6;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="485" y="1317" width="270" height="96" as="geometry"/></mxCell><mxCell id="p0-D7" value="งานยาวหลายเซสชัน&lt;br&gt;หรือเกิน ~10 งานย่อย?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="1472" width="250" height="116" as="geometry"/></mxCell><mxCell id="p0-LH" value="&lt;b&gt;long-horizon&lt;/b&gt;&lt;br&gt;6 gate · 1 phase = 1 branch&lt;br&gt;ledger บนดิสก์ (ดูหน้า 2)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="877" y="1485" width="240" height="90" as="geometry"/></mxCell><mxCell id="p0-B" value="ลงมือสร้างตามเป้าหมาย" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="505" y="1655" width="230" height="80" as="geometry"/></mxCell><mxCell id="p0-NT" value="&lt;b&gt;ทริกเกอร์ระหว่างทำ&lt;/b&gt;&lt;br&gt;• จะเขียน auth/ความลับ → owasp (ก่อนเขียน)&lt;br&gt;• แก้ธีม/คอนทราสต์ → ui-checker&lt;br&gt;• สร้างไฟล์ใหม่ → project-file-structure&lt;br&gt;• เจอบักที่ทำซ้ำได้ → debug-master" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=10;spacingRight=6;fontColor=#333333;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1127" y="1632" width="320" height="125" as="geometry"/></mxCell><mxCell id="p0-D8" value="ตรวจผ่านจริงไหม?&lt;br&gt;(รันเองและเห็นผลกับตา)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="1802" width="250" height="116" as="geometry"/></mxCell><mxCell id="p0-D9" value="พลาดเรื่องเดิม&lt;br&gt;ครบ 3 ครั้งหรือยัง?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="205" y="1802" width="250" height="116" as="geometry"/></mxCell><mxCell id="p0-STOP" value="&lt;b&gt;หยุด&lt;/b&gt;&lt;br&gt;อ่านเป้าหมายใหม่ ถามคน 1 คำถาม&lt;br&gt;แล้วตั้งโจทย์ใหม่" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="210" y="1995" width="240" height="90" as="geometry"/></mxCell><mxCell id="p0-FMT" value="&lt;b&gt;เสา Format&lt;/b&gt;&lt;br&gt;เขียนบันทึก/รายงานจากข้อมูลจริง&lt;br&gt;(commit, PR → github-report)" style="shape=document;size=0.15;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#e1d5e7;strokeColor=#9673a6;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="485" y="1990" width="270" height="100" as="geometry"/></mxCell><mxCell id="p0-E" value="จบ: งานที่เชื่อถือได้&lt;br&gt;+ บันทึกให้เซสชันหน้า" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="505" y="2187" width="230" height="66" as="geometry"/></mxCell><mxCell id="p0-e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;" edge="1" parent="1" source="p0-S" target="p0-D1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p0-e1" value="ใช่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fon