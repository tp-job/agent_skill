le=&quot;font-size:14px;color:#555555&quot;&gt;เลือกเฟสตามอาการ (ไม่แน่ใจ = รันทุกเฟส) → root cause 1 ประโยค → patch เล็กสุด → regression test → checklist&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395.0" y="10" width="1400" height="70" as="geometry"/></mxCell><mxCell id="sk-debug-master-S" value="เริ่ม&lt;br&gt;error / stack trace / &#x27;มีอะไรผิด&#x27;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="110" width="260" height="64" as="geometry"/></mxCell><mxCell id="sk-debug-master-D0" value="แอป PERN / MERN?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="234" width="330" height="100" as="geometry"/></mxCell><mxCell id="sk-debug-master-D0-R" value="&lt;b&gt;Full-stack triage&lt;/b&gt;&lt;br&gt;จัดชั้นก่อน: component · API · DB · auth · perf&lt;br&gt;ไล่เองไม่ถาม → issue report" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="235" width="300" height="98" as="geometry"/></mxCell><mxCell id="sk-debug-master-D1" value="ไม่เจอไฟล์ / import /&lt;br&gt;path ผิด?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="394" width="330" height="100" as="geometry"/></mxCell><mxCell id="sk-debug-master-D1-R" value="&lt;b&gt;PHASE 1 File System&lt;/b&gt;&lt;br&gt;path · ชนิดไฟล์ · folder tree · permission · dependency" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="404" widt