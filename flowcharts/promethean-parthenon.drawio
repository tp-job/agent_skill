arent="1"><mxGeometry x="410" y="996" width="300" height="62" as="geometry"/></mxCell><mxCell id="sk-debug-master-RT" value="&lt;b&gt;4-C Regression test&lt;/b&gt;&lt;br&gt;เทสต์เล็กสุดที่จะจับบักนี้ได้" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="1118" width="300" height="62" as="geometry"/></mxCell><mxCell id="sk-debug-master-CK" value="4-D ผ่าน checklist?&lt;br&gt;แก้ที่ต้นเหตุ · ไม่พัง caller · migration · flag · log ยืนยัน" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="1240" width="330" height="118" as="geometry"/></mxCell><mxCell id="sk-debug-master-END" value="Debug Report&lt;br&gt;classification · repro · findings · root cause · fix · test · prevention" style="shape=document;size=0.15;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#e1d5e7;strokeColor=#9673a6;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="1418" width="300" height="94" as="geometry"/></mxCell><mxCell id="sk-debug-master-note" value="&lt;b&gt;อาการ → เฟสแรก&lt;/b&gt;&lt;br&gt;FileNotFound / ModuleNotFound → 1&lt;br&gt;KeyError / NoneType / agent วน → 2&lt;br&gt;TLE / ผลคำนวณผิด → 3&lt;br&gt;&#x27;local ได้ prod ไม่ได้&#x27; → 1 + 2&lt;br&gt;&lt;br&gt;&lt;b&gt;multi-agent&lt;/b&gt;&lt;br&gt;log prompt/response ดิบ · ตรวจ schema ทุกรอยต่อ · replay ด้วย temperature 0" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=10;spacingRight=6;fontColor=#333333;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1225" y="110" width="320" height="188" as="geometry"/></mxCell><mxCell id="sk-debug-master-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ff