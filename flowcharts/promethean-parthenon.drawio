ooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sk-agentic-engineering-title" value="&lt;b style=&quot;font-size:24px&quot;&gt;agentic-engineering — เปลี่ยนคำขอบรรทัดเดียวเป็น brief&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#555555&quot;&gt;FRAME → INTERROGATE → BRIEF → CONFIRM → BUILD · กันโค้ดที่ &#x27;ดูถูก&#x27; แต่สร้างจาก requirement ที่ agent แต่งเอง&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395.0" y="10" width="1400" height="70" as="geometry"/></mxCell><mxCell id="sk-agentic-engineering-S" value="เริ่ม&lt;br&gt;คำขอบรรทัดเดียว แต่งานไม่เล็ก" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="110" width="260" height="64" as="geometry"/></mxCell><mxCell id="sk-agentic-engineering-D0" value="ระบุครบแล้ว / เป็น spike /&lt;br&gt;มี spec อยู่แล้ว?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="234" width="330" height="100" as="geometry"/></mxCell><mxCell id="sk-agentic-engineering-D0-R" value="ไม่ต้องเขียน brief&lt;br&gt;ลงมือ · ตั้งกรอบเวลา · หรือเช็ค spec กับ 4 คำถาม" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="243" width="300" height="82" as="geometry"/></mxCell><mxCell id="sk-agentic-engineering-FR" value="&lt;b&gt;1 FRAME&lt;/b&gt;&lt;br&gt;ตอบ 4 คำถามจากคำขอที่ได้มา" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="394" width="300" height="62" as="geometry"/></mxCell><mxCell id="sk-agentic-engineering-IN" value="&lt;b&gt;2 INTERROGATE&lt;/b&gt;&lt;br&gt;ขุดกฎที่ไม่มีใครพูด: หมดอายุ · ใช้ซ้ำ · rate limit · concurrency · ทางล้มเหลว" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="516" width="300" height="80" as="geometry"/></mxCell><mxCell id="sk-agentic-engineering-D1" value="ข้อจำกัดยังเป็น&lt;br&gt;คำคุณศัพท์? (&#x27;ปลอดภัย&#x27;)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="656" width="330" height="100" as="geometry"/></mxCell><mxCell id="sk-agentic-engineering-BR" value="&lt;b&gt;3 BRIEF หน้าเดียว&lt;/b&gt;&lt;br&gt;scope · rules · out-of-scope · proof (ชื่อเทสต์)" style="shape=document;size=0.15;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#e1d5e7;strokeColor=#9673a6;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="816" width="300" height="94" as="geometry"/></mxCell><mxCell id="sk-agentic-engineering-D2" value="4 CONFIRM&lt;br&gt;มีเรื่องที่ตัดสินเองไม่ได้จริง?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="970" width="330" height="100" as="geometry"/></mxCell><mxCell id="sk-agentic-engineering-D2-R" value="ถามผู้ใช้&lt;br&gt;เรื่องที่วิศวกรเลือกเองได้ → เลือกแล้วบอก" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="989" width="300" height="62" as="geometry"/></mxCell><mxCell id="sk-agentic-engineering-BU" value="&lt;b&gt;5 BUILD ตาม brief&lt;/b&gt;&lt;br&gt;brief คือความจริง ไม่ใช่แชท" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeCol