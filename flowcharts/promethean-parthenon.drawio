tFamily=Tahoma;fontSize=12;strokeColor=#999999;dashed=1;dashPattern=1 3;endArrow=open;endFill=0;fontColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="659" y="3236" as="sourcePoint"/><mxPoint x="719" y="3236" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1-lget2" value="อ้างอิง / ใช้ประกอบ" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="729" y="3224" width="210" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="sk-senior-leadership-advisor" name="3 senior-leadership-advisor: ตัดสินใจแบบผู้นำ"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sk-senior-leadership-advisor-title" value="&lt;b style=&quot;font-size:24px&quot;&gt;senior-leadership-advisor — ตอบแบบผู้นำอาวุโส&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#555555&quot;&gt;จับ role → คิด 7 ข้อ → ตั้งทีมถ้าหลาย role → ตัดสินข้อขัดแย้ง → ตอบเสียงเดียวพร้อมคำแนะนำ&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395.0" y="10" width="1400" height="70" as="geometry"/></mxCell><mxCell id="sk-senior-leadership-advisor-S" value="เริ่ม&lt;br&gt;คำถามเชิงตัดสินใจ / critique / กลยุทธ์" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="110" width="260" height="64" as="geometry"/></mxCell><mxCell id="sk-senior-leadership-advisor-D0" value="เป็นงานสร้าง&lt;br&gt;หลายเซสชัน?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="234" width="330" height="100" as="geometry"/></mxCell><mxCell id="sk-senior-leadership-advisor-D0-R" value="ส่งต่อ long-horizon-engineering-workflow&lt;br&gt;(งานสร้าง ไม่ใช่งานตัดสินใจ)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="252" width="300" height="64" as="geometry"/></mxCell><mxCell id="sk-senior-leadership-advisor-R1" value="&lt;b&gt;1 จับสัญญาณ → เลือก role 1–2 ตัว&lt;/b&gt;&lt;br&gt;Software · IoT · UX/UI · Writing · บริหาร · Silicon R&amp;amp;D/TEST/SELL/Client&lt;br&gt;สวมบทเลย ไม่ประกาศ ไม่ถาม" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="394" width="300" height="98" as="geometry"/></mxCell><mxCell id="sk-senior-leadership-advisor-D1" value="ข้อมูลบางจน&lt;br&gt;ตอบไม่ได้ทุก role?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="552" width="330" height="100" as="geometry"/></mxCell><mxCell id="sk-senior-leadership-advisor-D1-R" value="ถามหา input ที่ขาด&lt;br&gt;(ไม่ถามว่า &#x27;ใช้ role ไหน&#x27;)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="571" width="300" height="62" as="geometry"/></mxCell><mxCell id="sk-senior-leadership-advisor-D2" value="มีหลาย role&lt;br&gt;เกี่ยวข้อง?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="712" width="330" height="100" as="geometry"/></mxCell><mxCell id="sk-senior-leadership-advisor-D2-R" value="&lt;b&gt;3 ตั้งทีม: lead 1 + support 1–3&lt;/b&gt;&lt;br&gt;lead = role ที่ผู้ใช้ระบุ → เจ้าของ artifact → เจ้าของผลลัพธ์ → ผู้แยกสาเหตุ&lt;br&gt;support ต้องเปลี่ยนคำแนะนำได้จริง" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="713" width="300" height="98" as="geometry"/></mxCell><mxCell id="sk-senior-leadership-advisor-T7" value="&lt;b&gt;2 คิดก่อนตอบ 7 ข้อ&lt;/b&gt;&lt;br&gt;รอบด้าน · ครอบคลุม · ทุก use case · องค์รวม · edge case · first principles · pre-mortem" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="872" width="300" height="98" as="geometry"/></mxCell><mxCell id="sk-senior-leadership-advisor-D3" value="role ขัดกัน?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="1038" width="330" height="100" as="geometry"/></mxCell><mxCell id="sk-senior-leadership-advisor-D3-R" value="&lt;b&gt;บันไดตัดสินข้อขัดแย้ง&lt;/b&gt;&lt;br&gt;ข้อเท็จจริง → ระบุสิ่งที่วัด&lt;br&gt;ความเสี่ยง → เจ้าของผลชนะ&lt;br&gt;ลำดับความสำคัญ → lead ตัดสิน&lt;br&gt;ทางตัน+ย้อนไม่ได้ → ส่งผู้ใช้พร้อมกฎตัดสินใจ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="1030" width="300" height="116" as="geometry"/></mxCell><mxCell id="sk-senior-leadership-advisor-A" value="&lt;b&gt;4 ตอบแบบผู้นำ เสียงเดียว&lt;/b&gt;&lt;br&gt;คำแนะนำ → trade-off หลัก → ความเสี่ยง → ขั้นต่อไป" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="1206" width="300" height="80" as="geometry"/></mxCell><mxCell id="sk-senior-leadership-advisor-END" value="จบ: มีการตัดสินใจที่ชัด&lt;br&gt;ไม่ใช่เมนูตัวเลือก" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="1346" width="260" height="64" as="geometry"/></mxCell><mxCell id="sk-senior-leadership-advisor-note" value="&lt;b&gt;กับดักที่ต้องเลี่ยง&lt;/b&gt;&lt;br&gt;• role theater: 4 หัวข้อ 4 เสียง ไม่มีข้อสรุป&lt;br&gt;• ถามผู้ใช้ว่า &#x27;จะให้ตอบในบทไหน&#x27;&lt;br&gt;• สาย Silicon: ย้อนไม่ได้ → บอกว่าอยู่ฝั่งไหนของ tapeout&lt;br&gt;&lt;br&gt;&lt;b&gt;อ่านต่อ&lt;/b&gt;&lt;br&gt;references/roles.md · thinking-framework.md · team-protocol.md" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=10;spacingRight=6;fontColor=#333333;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1225" y="110" width="320" height="188" as="geometry"/></mxCell><mxCell id="sk-senior-leadership-advisor-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-senior-leadership-advisor-S" target="sk-senior-leadership-advisor-D0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sk-senior-leadership-advisor-e2" value="ไม่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-senior-leadership-advisor-D0" target="sk-senior-leadership-advisor-R1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sk-senior-leadership-advisor-e3" value="ใช่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff