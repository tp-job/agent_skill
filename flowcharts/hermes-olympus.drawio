"1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sk-capability-inventory-title" value="&lt;b style=&quot;font-size:24px&quot;&gt;capability inventory — ความสามารถที่มีจริงในเซสชัน&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#555555&quot;&gt;ไล่ 5 ข้อตามลำดับ หยุดเมื่อเจอ · ความเชื่อของ model เรื่อง tool ไม่ใช่รายการ tool จริง&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395.0" y="10" width="1400" height="70" as="geometry"/></mxCell><mxCell id="sk-capability-inventory-S" value="เริ่ม&lt;br&gt;งานต้องใช้ความสามารถบางอย่าง" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="110" width="260" height="64" as="geometry"/></mxCell><mxCell id="sk-capability-inventory-Q1" value="1 มี skill&lt;br&gt;ที่ trigger ตรง?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="234" width="330" height="100" as="geometry"/></mxCell><mxCell id="sk-capability-inventory-Q1-R" value="ใช้ skill นั้น" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="254" width="300" height="60" as="geometry"/></mxCell><mxCell id="sk-capability-inventory-Q2" value="2 มี MCP tool&lt;br&gt;ที่โหลดแล้ว?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="394" width="330" height="100" as="geometry"/></mxCell><mxCell id="sk-capability-inventory-Q2-R" value="เรียก tool" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor