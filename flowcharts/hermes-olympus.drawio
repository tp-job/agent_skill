8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="252" width="300" height="64" as="geometry"/></mxCell><mxCell id="sk-routing-and-delegation-D1" value="1 skill ที่ trigger ตรง?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="394" width="330" height="100" as="geometry"/></mxCell><mxCell id="sk-routing-and-delegation-D1-R" value="ใช้ skill" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="414" width="300" height="60" as="geometry"/></mxCell><mxCell id="sk-routing-and-delegation-D2" value="2 tool เฉพาะ&lt;br&gt;(built-in / MCP)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="554" width="330" height="100" as="geometry"/></mxCell><mxCell id="sk-routing-and-delegation-D2-R" value="ใช้ tool เฉพาะ&lt;br&gt;งานหลาย object → หา bulk operation ก่อน" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="572" width="300" height="64" as="geometry"/></mxCell><mxCell id="sk-routing-and-delegation-G" value="&lt;b&gt;3 tool ทั่วไป (shell, web fetch)&lt;/b&gt;&lt;br&gt;ยืดหยุ่น แต่เราต้องรับผิดชอบความถูกต้องเอง" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="714" width="300" height="62" as="geometry"/></mxCell><mxCell id="sk-routing-and-delegation-D4" value="4 ควรใช้ subagent?&lt;br&gt;ผู้ใช้ขอ · งานขนานได้ · sweep อ่านอย่างเดียว · ต้องแยก worktree" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="836" width="330" height="136" as="geometry"/></mxCell><mxCell id="sk-routing-and-delegation-D4-R" value="เขียน brief ที่ยืนได้เอง&lt;br&gt;เป้า · ไฟล์ · ข้อจำกัด · สิ่งที่ต้องส่งกลับ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="873" width="300" height="62" as="geometry"/></mxCell><mxCell id="sk-routing-and-delegation-EF" value="&lt;b&gt;เลือก effort ก่อนเปลี่ยน model&lt;/b&gt;&lt;br&gt;งานซ้ำ low · ออกแบบ/พังสองครั้ง high–max · ย้อนไม่ได้ max + คนอนุมัติ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="1032" width="300" height="80" as="geometry"/></mxCell><mxCell id="sk-routing-and-delegation-D5" value="แตกงานไปหลาย worker?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="1172" width="330" height="100" as="geometry"/></mxCell><mxCell id="sk-routing-and-delegation-D5-R" value="fan out แล้ว verify&lt;br&gt;&#x27;done&#x27; ของ worker เป็นแค่คำอ้าง → สุ่มตรวจก่อนรวม" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="1182" width="300" height="80" as="geometry"/></mxCell><mxCell id="sk-routing-and-delegation-END" value="จบ" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="1332" width="260" height="60" as="geometry"/></mxCell><mxCell id="sk-routing-and-delegation-note" value="&lt;b&gt;pattern หลาย agent&lt;/b&gt;&lt;br&gt;orchestrator–workers · pipeline + gate · reviewer · fan-out แล้ว merge&lt;br&gt;&lt;br&gt;&lt;b&gt;ไม่ควรใช้หลาย agent&lt;/b&gt;&lt;br&gt;งานอิสระ &amp;lt; 5 ชิ้น หรือแต่ละขั้นต้องรอผลขั้นก่อน" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=10;spacingRight=6;fontColor=#333333;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1225" y="110" width="320" height="134" as="geometry"/></mxCell><mxCell id="sk-routing-and-delegation-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-routing-and-delegation-S" target="sk-routing-and-delegation-D0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sk-routing-and-delegation-e2" value="มี" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-routing-and-delegation-D0" target="sk-routing-and-delegation-D1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sk-routing-and-delegation-e3" value="ไม่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-routing-and-delegation-D0" target="sk-routing-and-delegation-D0-R"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sk-routing-and-delegation-e4" value="ไม่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=blo