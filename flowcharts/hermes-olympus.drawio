odel → เขียน → ตรวจก่อนส่ง → บันทึก proven by&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395.0" y="10" width="1400" height="70" as="geometry"/></mxCell><mxCell id="sk-building-mcp-servers-S" value="เริ่ม&lt;br&gt;ความสามารถที่ต้องการไม่มี" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="110" width="260" height="64" as="geometry"/></mxCell><mxCell id="sk-building-mcp-servers-D0" value="เป็นแค่คำสั่ง /&lt;br&gt;workflow?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="234" width="330" height="100" as="geometry"/></mxCell><mxCell id="sk-building-mcp-servers-D0-R" value="เขียนเป็น skill" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="254" width="300" height="60" as="geometry"/></mxCell><mxCell id="sk-building-mcp-servers-D1" value="มีใน registry แล้ว?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="394" width="330" height="100" as="geometry"/></mxCell><mxCell id="sk-building-mcp-servers-D1-R" value="ติดตั้งตัวที่มี" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="414" width="300" height="60" as="geometry"/></mxCell><mxCell id="sk-building-mcp-servers-D2" value="ใช้ซ้ำข้ามโปรเจกต์ / ทีม&lt;br&gt;และแตะระบบภายนอก?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="554" width="330" height="100" as="geometry"/></mxCell><mxCell id="sk-building-mcp-servers-D2-R" value="script ที่ agent รัน&lt;br&gt;ในโปรเจกต์เดียว" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="572" width="300" height="64" as="geometry"/></mxCell><mxCell id="sk-building-mcp-servers-DS" value="&lt;b&gt;ออกแบบ tool surface&lt;/b&gt;&lt;br&gt;ชื่อตามผลลัพธ์ · tool น้อยแต่ต่อกันได้ · input มี type · error ที่สอน · output แบ่งหน้า" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="714" width="300" height="80" as="geometry"/></mxCell><mxCell id="sk-building-mcp-servers-DX" value="tool ที่ทำลายข้อมูล&lt;br&gt;destructiveHint + ต้องมี confirm=true" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="854" width="300" height="62" as="geometry"/></mxCell><mxCell id="sk-building-mcp-servers-W" value="&lt;b&gt;เขียน server (FastMCP, stdio)&lt;/b&gt;&lt;br&gt;credential มาจาก env ไม่ใช่ argument" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="976" width="300" height="62" as="geometry"/></mxCell><mxCell id="sk-building-mcp-servers-V" value="ตรวจก่อนส่ง?&lt;br&gt;เรียกจริงทุก tool · input ผิดได้ error ที่ชี้ทาง · ชื่อใน error มีจริง · ไม่มี secret" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395" y="1098" width="330" height="136" as="geometry"/></mxCell><mxCell id="sk-building-mcp-servers-END" value="เขียน capa