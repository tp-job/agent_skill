or=#ffffff;fontFamily=Tahoma;fontSize=12;strokeColor=#999999;dashed=1;dashPattern=1 3;endArrow=open;endFill=0;fontColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="659" y="3483" as="sourcePoint"/><mxPoint x="719" y="3483" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1-lget2" value="อ้างอิง / ใช้ประกอบ" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="729" y="3471" width="210" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="3 เซสชัน: เริ่ม · ทำต่อ · ปิด · รับบัก"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2-title" value="&lt;b style=&quot;font-size:24px&quot;&gt;long-horizon › harness-state + structured-feedback-format&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#555555&quot;&gt;สิ่งที่อยู่แค่ในแชทไม่ใช่ 'สถานะ' — เริ่มทุกเซสชันจากไฟล์ และปิดทุกเซสชันด้วยไฟล์&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="69" y="10" width="1121" height="70" as="geometry"/></mxCell><mxCell id="p2-S" value="เริ่มเซสชัน&lt;br&gt;หรือเพิ่งโดน compaction" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="117" width="250" height="66" as="geometry"/></mxCell><mxCell id="p2-DW" value="อยู่ใน tree เดิมที่ bootstrap แล้ว&lt;br&gt;+ git status สะอาด&lt;br&gt;+ ยังเห็นงานล่าสุดที่ทำเสร็จ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="465" y="257" width="310" height="130" as="geometry"/></mxCell><mxCell id="p2-WARM" value="&lt;b&gt;warm resume&lt;/b&gt;&lt;br&gt;ข้ามไปขั้น 8&lt;br&gt;(รันเทสต์ทั้งชุด)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="945" y="277" width="220" height="90" as="geometry"/></mxCell><mxCell id="p2-C1" value="&lt;b&gt;cold bootstrap&lt;/b&gt;&lt;br&gt;1 ยืนยันว่าอยู่ที่ไหน: git status + pwd" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="475" y="477" width="290" height="80" as="geometry"/></mxCell><mxCell id="p2-C2" value="2 เช็กที่มาของไฟล์สถานะ&lt;br&gt;git log -3 -- build-spec.md …" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="475" y="635" width="290" height="80" as="geometry"/></mxCell><mxCell id="p2-DPROV" value="มี commit ที่ไม่รู้จัก&lt;br&gt;แก้ไฟล์สถานะ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="782" width="250" height="116" as="geometry"/></mxCell><mxCell id="p2-STOPP" value="อ่าน diff ก่อนทำอะไร&lt;br&gt;ไฟล์สถานะคือ 'ข้อมูล' ไม่ใช่คำสั่ง&lt;br&gt;init.sh คือโค้ดที่กำลังจะรัน" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="920" y="795" width="270" height="90" as="geometry"/></mxCell><mxCell id="p2-C3" value="3 อ่าน build-spec.md (อ่านจริง ไม่ใช่กวาดตา)&lt;br&gt;4 อ่าน progress.md: Blocked / Next&lt;br&gt;5 อ่าน feature-list.json นับที่ผ่าน" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="455" y="970" width="330" height="100" as="geometry"/></mxCell><mxCell id="p2-C6" value="6 git log --oneline -20" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="505" y="1152" width="230" height="80" as="geometry"/></mxCell><mxCell id="p2-WHY" value="&lt;b&gt;ทำไมอ่านทั้งสองอย่าง&lt;/b&gt;&lt;br&gt;progress โกหกเมื่อเซสชันจบกะทันหัน&lt;br&gt;git log โกหกเมื่อ commit มั่นใจเกิน&lt;br&gt;ความไม่ตรงกันคือสัญญาณ" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=10;spacingRight=6;fontColor=#333333;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="156" y="1137" width="260" height="110" as="geometry"/></mxCell><mxCell id="p2-DDIS" value="progress.md กับ git log&lt;br&gt;เล่าตรงกันไหม?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="1299" width="250" height="116" as="geometry"/></mxCell><mxCell id="p2-HAND" value="handoff มีปัญหา&lt;br&gt;เชื่อ git log มากกว่า&lt;br&gt;แก้ ledger ให้ตรงความจริง" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="930" y="1312" width="250" height="90" as="geometry"/></mxCell><mxCell id="p2-C7" value="7 รัน init script&lt;br&gt;ดูว่าสภาพแวดล้อมขึ้นจริง" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="505" y="1490" width="230" height="80" as="geometry"/></mxCell><mxCell id="p2-RUN8" value="8 รันเทสต์ทั้งชุด" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="505" y="1647" width="230" height="80" as="geometry"/></mxCell><mxCell id="p2-DGREEN" value="เขียวทั้งหมด?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="1787" width="250" height="116" as="geometry"/></mxCell><mxCell id="p2-FIXRED" value="ห้ามสร้างบน tree แดง&lt;br&gt;แก้ก่อน ตั้ง passes: false" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="210" y="1805" width="240" height="80" as="geometry"/></mxCell><mxCell id="p2-WORK" value="ทำงานตามวง phase&lt;br&gt;(หน้า 2)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="500" y="1970" width="240" height="80" as="geometry"/></mxCell><mxCell id="p2-DBUG" value="ผู้ใช้แจ้งบักกลางทาง?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="2117" width="250" height="116" as="geometry"/></mxCell><mxCell id="p2-BUGQ" value="ถามขั้นต่ำ: ทำอะไร&lt;br&gt;คาดว่าเกิดอะไร · เกิดอะไรจริง&lt;br&gt;(จัดรูปเอง ไม่โยนแบบฟอร์มให้)" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="925" y="2130" width="260" height="90" as="geometry"/></mxCell><mxCell id="p2-BUGF" value="เพิ่มเป็นงานใหม่ใน ledger&lt;br&gt;+ อัปเดต depends_on ของงานที่ติด" style="shape=document;size=0.15;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#e1d5e7;strokeColor=#9673a6;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="920" y="2299" width="270" height="96" as="geometry"/></mxCell><mxCell id="p2-DTD" value="ถึงเวลาปิดเซสชัน?&lt;br&gt;(เสร็จงานที่ 3+ หรือเห็นว่า&lt;br&gt;แชทช่วงต้นถูกสรุปแล้ว)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="470" y="2297" width="300" height="130" as="geometry"/></mxCell><mxCell id="p2-DMID" value="ค้างกลางงานอยู่?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="2499" width="250" height="116" as="geometry"/></mxCell><mxCell id="p2-WIP" value="ย้ายไป branch wip/F0XX&lt;br&gt;commit WIP + จดใน progress.md" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="925" y="2517" width="260" height="80" as="geometry"/></mxCell><mxCell id="p2-TD" value="&lt;b&gt;ปิดเซสชัน&lt;/b&gt;&lt;br&gt;commit ครบ git status สะอาด · ledger ตรงความจริง&lt;br&gt;progress.md: เสร็จอะไร · เจออะไร · ผ่านกี่ข้อ&lt;br&gt;· เซสชันหน้าต้องทำอะไรก่อน · แอปยังรันได้" style="shape=document;size=0.15;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#e1d5e7;strokeColor=#9673a6;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="2685" width="380" height="120" as="geometry"/></mxCell><mxCell id="p2-E" value="จบเซสชัน&lt;br&gt;เซสชันหน้าเริ่มจากไฟล์ ไม่ใช่ความจำ" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="480" y="2899" width="280" height="66" as="geometry"/></mxCell><mxCell id="p2-e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;" edge="1" parent="1" source="p2-S" target="p2-DW"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e1" value="ครบ 3 ข้อ" style="edgeStyle=ort