e="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;spacing=6;" vertex="1" parent="1"><mxGeometry x="89" y="3138" width="60" height="34" as="geometry"/></mxCell><mxCell id="p0-lgt4" value="ถามผู้ใช้ / รอคนตอบ" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="159" y="3138" width="210" height="34" as="geometry"/></mxCell><mxCell id="p0-lg5" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;spacing=6;" vertex="1" parent="1"><mxGeometry x="374" y="3138" width="60" height="34" as="geometry"/></mxCell><mxCell id="p0-lgt5" value="ส่งต่อให้ skill อื่น" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="444" y="3138" width="210" height="34" as="geometry"/></mxCell><mxCell id="p0-lg6" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;spacing=6;" vertex="1" parent="1"><mxGeometry x="659" y="3138" width="60" height="34" as="geometry"/></mxCell><mxCell id="p0-lgt6" value="หยุด / ห้ามทำ" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="729" y="3138" width="210" height="34" as="geometry"/></mxCell><mxCell id="p0-lg7" value="" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=10;spacingRight=6;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="944" y="3138" width="60" height="34" as="geometry"/></mxCell><mxCell id="p0-lgt7" value="หมายเหตุ" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1014" y="3138" width="210" height="34" as="geometry"/></mxCell><mxCell id="p0-lge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="89" y="3206" as="sourcePoint"/><mxPoint x="149" y="3206" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p0-lget0" value="เส้นทางหลัก" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="159" y="3194" width="210" height="24" as="geometry"/></mxCell><mxCell id="p0-lge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;strokeColor=#b85450;dashed=1;fontColor=#b85450;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="374" y="3206" as="sourcePoint"/><mxPoint x="434" y="3206" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p0-lget1" value="วนกลับ (loop)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="444" y="3194" width="210" height="24" as="geometry"/></mxCell><mxCell id="p0-lge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;strokeColor=#999999;dashed=1;dashPattern=1 3;endArrow=open;endFill=0;fontColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="659" y="3206" as="sourcePoint"/><mxPoint x="719" y="3206" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p0-lget2" value="อ้างอิง / ใช้ประกอบ" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="729" y="3194" width="210" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="2 Gate 3: วง phase และวงทีละงาน"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1-title" value="&lt;b style=&quot;font-size:24px&quot;&gt;long-horizon › feature-loop + phases-and-branches&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#555555&quot;&gt;1 phase = 1 branch · ทีละ 1 งาน: เทสต์ที่เกี่ยว → เลือก → ทำ → ตรวจ → refactor → ledger → commit&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="69" y="10" width="1352" height="70" as="geometry"/></mxCell><mxCell id="p1-S" value="เข้า Gate 3&lt;br&gt;(harness พร้อมแล้ว)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="505" y="117" width="230" height="66" as="geometry"/></mxCell><mxCell id="p1-DSZ" value="งานย่อยเกิน ~10 ชิ้น?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="257" width="250" height="116" as="geometry"/></mxCell><mxCell id="p1-ONE" value="ไม่แบ่ง phase&lt;br&gt;ใช้ branch เดียว" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="215" y="275" width="230" height="80" as="geometry"/></mxCell><mxCell id="p1-CUT" value="&lt;b&gt;ตัด phase ให้ดี&lt;/b&gt;&lt;br&gt;• จบด้วยสิ่งที่สาธิตได้ (signup ไม่ใช่ database)&lt;br&gt;• ไม่มีสัญญาข้ามเส้น phase&lt;br&gt;• merge ได้ใน 1–2 เซสชัน · revert ได้ทั้งก้อน" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=10;spacingRight=6;fontColor=#333333;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="962" y="255" width="330" height="120" as="geometry"/></mxCell><mxCell id="p1-P1" value="&lt;b&gt;เปิด branch ของ phase&lt;/b&gt;&lt;br&gt;1 phase = 1 branch&lt;br&gt;(phase ก่อนหน้าต้อง merge แล้ว)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="490" y="442" width="260" height="90" as="geometry"/></mxCell><mxCell id="p1-AFF" value="รันเทสต์เฉพาะที่เกี่ยวกับไฟล์ที่จะแตะ&lt;br&gt;+ งานที่ depends_on งานนี้" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="475" y="612" width="290" height="80" as="geometry"/></mxCell><mxCell id="p1-DRED" value="มีอะไรแดง&lt;br&gt;(regression)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="759" width="250" height="116" as="geometry"/></mxCell><mxCell id="p1-FIXR" value="หยุด แก้ก่อนงานใหม่&lt;br&gt;ตั้ง passes: false ทันที" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="882" y="777" width="230" height="80" as="geometry"/></mxCell><mxCell id="p1-SEL" value="&lt;b&gt;เลือก 1 งาน&lt;/b&gt;&lt;br&gt;critical → high → medium → low&lt;br&gt;ไม่ติด block ก่อน · ประกาศ 1 บรรทัด" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="475" y="937" width="290" height="90" as="geometry"/></mxCell><mxCell id="p1-ONLY" value="ห้ามทำ 2 งานพร้อมกัน&lt;br&gt;ยกเว้นงานเล็ก ≤ 3 ชิ้น หมวดเดียว&lt;br&gt;ชิ้นละ &amp;lt; 10 บรรทัด ตรวจทีละชิ้น" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=10;spacingRight=6;fontColor=#333333;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="161" y="937" width="250" height="90" as="geometry"/></mxCell><mxCell id="p1-DSTEP" value="งานนี้มีขั้นตอนตรวจ&lt;br&gt;3–7 ข้อแล้วหรือยัง?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="1089" width="250" height="116" as="geometry"/></mxCell><mxCell id="p1-WSTEP" value="เขียนขั้นตอนตรวจก่อนทำ&lt;br&gt;สังเกตได้ + กรณีพัง ≥ 1 ข้อ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="877" y="1107" width="240" height="80" as="geometry"/></mxCell><mxCell id="p1-IMP" value="ลงมือทำ&lt;br&gt;(การเปลี่ยนแปลงที่เล็กที่สุด)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="505" y="1272" width="230" height="80" as="geometry"/></mxCell><mxCell id="p1-VER" value="&lt;b&gt;ตรวจผ่าน interface จริง&lt;/b&gt;&lt;br&gt;เว็บ → เบราว์เซอร์ · API → HTTP จริง&lt;br&gt;CLI → รันคำสั่ง · library → public API" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="470" y="1427" width="300" height="100" as="geometry"/></mxCell><mxCell id="p1-PROVE" value="&lt;b&gt;2 เช็กที่มักถูกข้าม&lt;/b&gt;&lt;br&gt;• ทำให้เทสต์พังโดยตั้งใจ ดูมันแดง แล้วคืน&lt;br&gt;• สคริปต์เขียนข้อมูลจำนวนมาก:&lt;br&gt;  รันครั้งที่ 2 ต้องไม่เปลี่ยนอะไร" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=10;spacingRight=6;fontColor=#333333;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="156" y="1417" width="260" height="120" as="geometry"/></mxCell><mxCell id="p1-DVER" value="ผ่านครบทุกข้อ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="1599" width="250" height="116" as="geometry"/></mxCell><mxCell id="p1-DENV" value="ข้อที่ไม่ผ่าน รันใน&lt;br&gt;สภาพแวดล้อมนี้ไม่ได้?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="867" y="1599" width="260" height="116" as="geometry"/></mxCell><mxCell id="p1-BLK" value="บันทึก blocked&lt;br&gt;+ blocked_reason&lt;br&gt;+ recheck_when" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1211" y="1612" width="210" height="90" as="geometry"/></mxCell><mxCell id="p1-DTRY" value="ลองครบ 3 วิธี&lt;br&gt;หรือ 3 รอบแล้ว?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="882" y="1794" width="230" height="116" as="geometry"/></mxCell><mxCell id="p1-STUCK" value="เขียนสิ่งที่ติดลง notes + progress.md&lt;br&gt;บักใหม่ → งานใหม่ + depends_on&lt;br&gt;ครบ 3 รอบ → กลับไปถามผู้ใช้" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="852" y="1990" width="290" height="100" as="geometry"/></mxCell><mxCell id="p1-REFAC" value="&lt;b&gt;refactor เฉพาะที่งานนี้แตะ&lt;/b&gt;&lt;br&gt;ไม่เปลี่ยนพฤติกรรม · ลบ debug&lt;br&gt;รวม utility ซ้ำ · ชื่อตรงสเปก" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="480" y="1802" width="280" height="100" as="geometry"/></mxCell><mxCell id="p1-REVER" value="รันขั้นตอนตรวจเดิม&lt;br&gt;ผ่านอีกครั้ง?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="1982" width="250" height="116" as="geometry"/></mxCell><mxCell id="p1-LED" value="อัปเดต ledger: passes: true&lt;br&gt;(แก้ได้แค่ passes กับ notes)" style="shape=document;size=0.15;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#e1d5e7;strokeColor=#9673a6;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="485" y="2164" width="270" height="96" as="geometry"/></mxCell><mxCell id="p1-COM" value="&lt;b&gt;commit ทันที เรื่องเดียว&lt;/b&gt;&lt;br&gt;stage เฉพาะไฟล์ที่แก้ (ไม่ใช้ -A)&lt;br&gt;ลง branch ของ phase" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="475" y="2332" width="290" height="90" as="geometry"/></mxCell><mxCell id="p1-DMORE" value="ยังมีงาน&lt;br&gt;ใน phase นี้?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="2484" width="250" height="116" as="geometry"/></mxCell><mxCell id="p1-PCK" value="&lt;b&gt;ปิด phase&lt;/b&gt;&lt;br&gt;ทุกงาน true หรือ blocked · เทสต์ทั้งชุดเขียวบน branch&lt;br&gt;· สาธิตผลจริงแล้ว · บันทึกสิ่งที่เรียนรู้ใน progress.md" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="440" y="2672" width="360" height="100" as="geometry"/></mxCell><mxCell id="p1-MRG" value="merge เข้า main&lt;br&gt;จด sha ลงแถวของ phase" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="505" y="2855" width="230" height="80" as="geometry"/></mxCell><mxCell id="p1-DPH" value="ยังมี phase ถัดไป?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="3002" width="250" height="116" as="geometry"/></mxCell><mxCell id="p1-E" value="ครบทุก phase&lt;br&gt;→ ตรวจ Gate 3 (หน้า 1)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="505" y="3199" width="230" height="66" as="geometry"/></mxCell><mxCell id="p1-e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;" edge="1" parent="1" source="p1-S" target="p1-DSZ"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e1" value="ไม่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-DSZ" target="p1-ONE"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-ONE" target="p1-AFF"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e3" value="ใช่" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;" edge="1" parent="1" source="p1-DSZ" target="p1-P1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e4" value="ใช้ตอนวางแผน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;strokeColor=#999999;dashed=1;dashPattern=1 3;endArrow=open;endFill=0;fontColor=#666666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-CUT" target="p1-P1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1127" y="487"/></Array></mxGeometry></mxCell><mxCell id="p1-e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;" edge="1" parent="1" source="p1-P1" target="p1-AFF"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;" edge="1" parent="1" source="p1-AFF" target="p1-DRED"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e7" value="มี" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-DRED" target="p1-FIXR"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e8" value="แก้แล้ว" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;strokeColor=#b85450;dashed=1;fontColor=#b85450;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-FIXR" target="p1-AFF"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-e9" value="ไม่มี" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=T