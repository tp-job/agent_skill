<mxfile host="Electron" agent="agent-skill flowcharts" version="24.0.0"><diagram id="p0" name="1 วงนอก: 6 gate ของทั้งงาน"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p0-title" value="&lt;b style=&quot;font-size:24px&quot;&gt;long-horizon-engineering-workflow — งานสร้างหลายเซสชัน&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#555555&quot;&gt;เป้าหมายที่เขียนแล้ว → ความต้องการ → ออกแบบ + สร้าง harness → พัฒนา → ทดสอบรวม → ผู้ใช้รับ → ปล่อยของ&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="69" y="10" width="1208" height="70" as="geometry"/></mxCell><mxCell id="p0-S" value="รับเป้าหมายที่เขียนแล้ว&lt;br&gt;(brief หรือสัญญาจากโค้ดเดิม)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="485" y="117" width="270" height="66" as="geometry"/></mxCell><mxCell id="p0-DSM" value="งานย่อย ≥ ~10 ชิ้น&lt;br&gt;หรือ ≥ 2 เซสชัน?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="257" width="250" height="116" as="geometry"/></mxCell><mxCell id="p0-SMALL" value="ไม่ต้องมี harness&lt;br&gt;ใช้ gate อย่างเดียว&lt;br&gt;branch เดียว + วงทีละงาน" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="215" y="270" width="230" height="90" as="geometry"/></mxCell><mxCell id="p0-G1" value="&lt;b&gt;Gate 1 ความต้องการ&lt;/b&gt;&lt;br&gt;ถาม 'สำเร็จหน้าตาเป็นยังไง' ก่อน 'สร้างยังไง'&lt;br&gt;คำว่า เร็ว / ง่าย / ดีขึ้น → ต้องวัดได้" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="460" y="442" width="320" height="90" as="geometry"/></mxCell><mxCell id="p0-G1O" value="&lt;b&gt;build-spec.md ส่วนที่ 1&lt;/b&gt;&lt;br&gt;ปัญหา · เกณฑ์ผ่านมีเลขกำกับ · สิ่งที่ไม่ทำ&lt;br&gt;· edge case · ฟีเจอร์ความปลอดภัยแยกรายการ" style="shape=document;size=0.15;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#e1d5e7;strokeColor=#9673a6;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="460" y="602" width="320" height="100" as="geometry"/></mxCell><mxCell id="p0-THINK" value="&lt;b&gt;คิดลึกตรงไหน&lt;/b&gt;&lt;br&gt;• Gate 1–2 และตอนแตกงาน&lt;br&gt;• Gate 6&lt;br&gt;• งานที่พลาดมาแล้ว 2 ครั้ง&lt;br&gt;รอบปกติไม่ต้องคิดลึก — ตัดสินไว้ข้างบนแล้ว" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=10;spacingRight=6;fontColor=#333333;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="982" y="535" width="290" height="130" as="geometry"/></mxCell><mxCell id="p0-DG1" value="ผู้ใช้ยืนยัน&lt;br&gt;สรุปเป้าหมายแล้ว?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="767" width="250" height="116" as="geometry"/></mxCell><mxCell id="p0-G2" value="&lt;b&gt;Gate 2 ออกแบบ&lt;/b&gt;&lt;br&gt;0 อ่านธรรมเนียม repo · 1 แตกงาน&lt;br&gt;2 หาของที่มีอยู่แล้ว · 3 กำหนด interface&lt;br&gt;4 เดินทุกกิ่ง (ว่าง / พัง / หมดเวลา)&lt;br&gt;5 สัญญาข้อมูลทุกจุดเชื่อม" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="460" y="940" width="320" height="130" as="geometry"/></mxCell><mxCell id="p0-SKIP" value="&lt;b&gt;ข้ามแล้วพังแบบนี้&lt;/b&gt;&lt;br&gt;• ไม่แตกงาน → ledger ไม่ติดตามอะไร&lt;br&gt;• ไม่หาของเดิม → utility ชุดที่ 4&lt;br&gt;• ไม่มี interface → เทสต์พังทุกครั้งที่ refactor&lt;br&gt;• ไม่มีสัญญาข้อมูล → shape ไม่ตรงทุกจุด" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=10;spacingRight=6;fontColor=#333333;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="977" y="940" width="300" height="130" as="geometry"/></mxCell><mxCell id="p0-DIG" value="git check-ignore&lt;br&gt;ไม่พิมพ์อะไรออกมา?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="1134" width="250" height="116" as="geometry"/></mxCell><mxCell id="p0-MOVE" value="ไฟล์สถานะจะถูก ignore&lt;br&gt;(เงียบและหายทั้งหมด)&lt;br&gt;เลือก path ใหม่" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="210" y="1147" width="240" height="90" as="geometry"/></mxCell><mxCell id="p0-DPUB" value="repo นี้เป็น public?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="1299" width="250" height="116" as="geometry"/></mxCell><mxCell id="p0-PRIV" value="ledger + progress บอกจุดอ่อน&lt;br&gt;ด้านความปลอดภัย&lt;br&gt;→ เก็บเป็นส่วนตัว" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="930" y="1312" width="250" height="90" as="geometry"/></mxCell><mxCell id="p0-H" value="&lt;b&gt;สร้าง harness 4 ไฟล์ที่ root&lt;/b&gt;&lt;br&gt;build-spec.md · feature-list.json (phase + งาน)&lt;br&gt;progress.md · init.sh → แล้ว commit" style="shape=document;size=0.15;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#e1d5e7;strokeColor=#9673a6;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="450" y="1480" width="340" height="100" as="geometry"/></mxCell><mxCell id="p0-PAY" value="&lt;b&gt;ทุกช่วงต่อต้องส่ง 'ของ' ต่อ&lt;/b&gt;&lt;br&gt;เซสชันถัดไปไม่มีความจำ&lt;br&gt;สิ่งที่ส่งต่อได้มีแค่ไฟล์กับ git" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=10;spacingRight=6;fontColor=#333333;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="992" y="1510" width="270" height="100" as="geometry"/></mxCell><mxCell id="p0-G3" value="&lt;b&gt;Gate 3 พัฒนา&lt;/b&gt;&lt;br&gt;วง phase + วงทีละงาน&lt;br&gt;(ดูหน้า 2 และหน้า 3)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="500" y="1665" width="240" height="90" as="geometry"/></mxCell><mxCell id="p0-DG3" value="ทุก phase merge + จด sha&lt;br&gt;critical / high ผ่านหมด&lt;br&gt;ที่เหลือผ่าน หรือ blocked ที่ผู้ใช้รับ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="460" y="1825" width="320" height="130" as="geometry"/></mxCell><mxCell id="p0-G4" value="&lt;b&gt;Gate 4 Integration QA&lt;/b&gt; (ไม่ใช่รัน Gate 3 ซ้ำ)&lt;br&gt;คู่ฟีเจอร์ที่พังเมื่อรวมกัน · user journey เต็มเส้น&lt;br&gt;· ฟีเจอร์เก่าที่ไม่ได้ตรวจซ้ำ · โหลด / พร้อมกัน&lt;br&gt;· รายการที่ ledger บอกว่ายังไม่เคยตรวจ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="435" y="2032" width="370" height="120" as="geometry"/></mxCell><mxCell id="p0-DG4" value="ผ่านไหม?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="2214" width="250" height="116" as="geometry"/></mxCell><mxCell id="p0-NEWF" value="เพิ่มเป็นงานใหม่ใน ledger&lt;br&gt;พร้อมขั้นตอนตรวจ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="935" y="2232" width="240" height="80" as="geometry"/></mxCell><mxCell id="p0-G5" value="&lt;b&gt;Gate 5 UAT&lt;/b&gt;&lt;br&gt;สคริปต์จาก use case ของ Gate 2&lt;br&gt;→ ผู้ใช้ลองเองแล้วเซ็นรับ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="470" y="2392" width="300" height="90" as="geometry"/></mxCell><mxCell id="p0-DG5" value="ผู้ใช้เซ็นรับ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="2552" width="250" height="116" as="geometry"/></mxCell><mxCell id="p0-FB" value="แปลง feedback เป็นงานใหม่&lt;br&gt;ทำอะไร / คาดว่า / เกิดจริง" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="210" y="2570" width="240" height="80" as="geometry"/></mxCell><mxCell id="p0-G6" value="&lt;b&gt;Gate 6 Deploy&lt;/b&gt;&lt;br&gt;แผน rollback · smoke test ที่ระบุชื่อ&lt;br&gt;· คนเฝ้าระบบหลังปล่อย" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="470" y="2737" width="300" height="90" as="geometry"/></mxCell><mxCell id="p0-E" value="ส่งงานแล้ว&lt;br&gt;→ เขียนรายงานจากข้อมูลจริง" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="490" y="2922" width="260" height="66" as="geometry"/></mxCell><mxCell id="p0-e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;