"10" width="1141" height="70" as="geometry"/></mxCell><mxCell id="p1-z0" value="ส่วน A: วาง skill ลง library" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=#f3f8ff;strokeColor=#9fb7d8;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontColor=#555555;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="54" y="225" width="1392" height="1665" as="geometry"/></mxCell><mxCell id="p1-z1" value="ส่วน B: ปรับ description ด้วยมือ" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=#fffaf0;strokeColor=#e0c080;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontColor=#555555;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="54" y="1905" width="1392" height="840" as="geometry"/></mxCell><mxCell id="p1-S" value="จะเพิ่ม skill ใหม่&lt;br&gt;เข้า library นี้" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="505" y="117" width="230" height="66" as="geometry"/></mxCell><mxCell id="p1-DOWN" value="มี active skill หรือ hub&lt;br&gt;เป็นเจ้าของ trigger นี้แล้ว?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="480" y="262" width="280" height="120" as="geometry"/></mxCell><mxCell id="p1-REFF" value="เพิ่มเป็นไฟล์ references/&lt;br&gt;ของ skill นั้นแทน&lt;br&gt;(เคยรวมแบบนี้มาแล้ว 4 ครั้ง)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="930" y="277" width="250" height="90" as="geometry"/></mxCell><mxCell id="p1-REALM" value="อยู่ realm ไหน?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="505" y="455" width="230" height="110" as="geometry"/></mxCell><mxCell id="p1-REALMN" value="core · design · web · stack · knowledge&lt;br&gt;realm = คำอังกฤษธรรมดา 1 คำ&lt;br&gt;hub ใหม่ = ชื่อเทพ 2 คำ (เรื่องใหญ่)" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=10;spacingRight=6;fontColor=#333333;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="920" y="487" width="270" height="90" as="geometry"/></mxCell><mxCell id="p1-FOLD" value="สร้างโฟลเดอร์ &amp;lt;realm&amp;gt;/&amp;lt;skill-name&amp;gt;/&lt;br&gt;ชื่อโฟลเดอร์ = name: ใน SKILL.md" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="470" y="642" width="300" height="80" as="geometry"/></mxCell><mxCell id="p1-FM" value="&lt;b&gt;frontmatter&lt;/b&gt;&lt;br&gt;name · description · license: MIT&lt;br&gt;· metadata (author, version &quot;1.0.0&quot;, source)" style="shape=document;size=0.15;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#e1d5e7;strokeColor=#9673a6;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="465" y="802" width="310" height="90" as="geometry"/></mxCell><mxCell id="p1-BODY" value="&lt;b&gt;SKILL.md เป็นตัวชี้ทาง ไม่ใช่สารานุกรม&lt;/b&gt;&lt;br&gt;≤ ~400 บรรทัด · ตาราง 'ต้องการ → อ่าน'&lt;br&gt;ลิงก์ markdown แบบ relative · 1 เรื่องต่อ 1 ไฟล์" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="445" y="970" width="350" height="100" as="geometry"/></mxCell><mxCell id="p1-NOWIKI" value="ห้าม [[wikilink]]&lt;br&gt;ห้าม path ใน backtick&lt;br&gt;ห้ามลิงก์ไฟล์ที่ไม่มีอยู่&lt;br&gt;ใช้โฟลเดอร์ references/ scripts/&lt;br&gt;assets/ เท่านั้น" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=10;spacingRight=6;fontColor=#333333;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="152" y="960" width="240" height="120" as="geometry"/></mxCell><mxCell id="p1-DLINK" value="ลิงก์ไป skill อื่นไหม?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="1142" width="250" height="116" as="geometry"/></mxCell><mxCell id="p1-NOLINK" value="ห้าม — skill ต้องใช้ได้เดี่ยวๆ&lt;br&gt;เปลี่ยนเป็นพูดถึง 'แนวคิด'&lt;br&gt;(มีแค่ hub ที่ลิงก์ได้ ผ่าน bundled/)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="915" y="1155" width="280" height="90" as="geometry"/></mxCell><mxCell id="p1-DHUB" value="จะให้เป็น spoke&lt;br&gt;ของ hub ไหม?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="1314" width="250" height="116" as="geometry"/></mxCell><mxCell id="p1-HUBA" value="เพิ่มใน HUBS (skills_layout.py)&lt;br&gt;ใส่ trigger ลง description + fast path ของ hub&lt;br&gt;วัดความยาว ≤ 1,536 ตัวอักษร" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="900" y="1322" width="310" height="100" as="geometry"/></mxCell><mxCell id="p1-CHK" value="&lt;b&gt;รันชุดตรวจ&lt;/b&gt;&lt;br&gt;build-index.py → build-bundles.py&lt;br&gt;→ check-bundles.py → lint-skills.py" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="470" y="1507" width="300" height="90" as="geometry"/></mxCell><mxCell id="p1-DCLEAN" value="ผ่านทั้งหมด?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent=