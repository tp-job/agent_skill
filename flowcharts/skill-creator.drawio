ounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="470" y="2055" width="300" height="90" as="geometry"/></mxCell><mxCell id="p0-DOK" value="ทุก case ผ่าน และ&lt;br&gt;ผู้ใช้เห็นว่าดีขึ้น?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;spacing=4;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="2214" width="250" height="116" as="geometry"/></mxCell><mxCell id="p0-EXP" value="ขยายชุดทดสอบ&lt;br&gt;แล้วลองในสเกลใหญ่ขึ้น" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="505" y="2405" width="230" height="80" as="geometry"/></mxCell><mxCell id="p0-DESC" value="ปรับ description ให้ trigger แม่น&lt;br&gt;(หน้า 2)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;spacing=6;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="490" y="2562" width="260" height="80" as="geometry"/></mxCell><mxCell id="p0-E" value="ส่งโฟลเดอร์ skill ให้ผู้ใช้&lt;br&gt;(ไม่มี script แพ็กเกจ)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontFamily=Tahoma;fontSize=13;" vertex="1" parent="1"><mxGeometry x="490" y="2734" width="260" height="66" as="geometry"/></mxCell><mxCell id="p0-e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontSize=12;" edge="1" parent="1" source="p0-S" target="p0-DWHERE"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p0-e1" value="อยากให้ trigger ดีขึ้นอย่างเดียว" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontFamily=Tahoma;fontS