<mxfile host="app.diagrams.net">
  <diagram id="test-strategy-flow" name="Test Strategy Flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== Main column ===== -->
        <mxCell id="start" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="20" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="plan" value="&lt;b&gt;1. Plan&lt;/b&gt;&lt;br&gt;scope · risk · exit criteria&lt;br&gt;&lt;i&gt;ใช้ promethean-parthenon&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="180" y="100" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="design" value="&lt;b&gt;2. Test Design&lt;/b&gt;&lt;br&gt;EP · Boundary Value&lt;br&gt;Decision Table · State Transition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="180" y="200" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="unit" value="&lt;b&gt;3. Unit Test&lt;/b&gt;&lt;br&gt;White box + Grey box&lt;br&gt;+ Function-level Fuzz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="180" y="300" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="Gate:&lt;br&gt;ผ่าน?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="240" y="400" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="integ" value="&lt;b&gt;4. Integration Test&lt;/b&gt;&lt;br&gt;Grey box&lt;br&gt;+ White / Black box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="180" y="510" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="Gate:&lt;br&gt;ผ่าน?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="240" y="610" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="system" value="&lt;b&gt;5. System Test&lt;/b&gt;&lt;br&gt;Black box + Grey box&lt;br&gt;+ API Fuzz · Performance · Security" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="180" y="720" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="Gate:&lt;br&gt;ผ่าน?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="240" y="830" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="accept" value="&lt;b&gt;6. Acceptance Test&lt;/b&gt;&lt;br&gt;Black box&lt;br&gt;Human + AI (agent เล่นบทผู้ใช้)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="180" y="940" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="g4" value="Exit criteria&lt;br&gt;ครบ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="230" y="1040" width="140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="report" value="&lt;b&gt;7. Report Table&lt;/b&gt;&lt;br&gt;สรุปผลทุกระดับ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="180" y="1170" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="end" value="End" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="1270" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- ===== Defect loop (right) ===== -->
        <mxCell id="defect" value="&lt;b&gt;Defect&lt;/b&gt;&lt;br&gt;บันทึก → Debug → Fix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="520" y="760" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="regress" value="&lt;b&gt;Regression&lt;/b&gt;&lt;br&gt;เพิ่ม input ที่ทำให้พัง เข้า&lt;br&gt;Decision Table / Fuzz corpus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="780" y="760" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="loopchk" value="วนเกิน&lt;br&gt;N รอบ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="820" y="880" width="120" height="90" as="geometry" />
        </mxCell>
        <mxCell id="escalate" value="&lt;b&gt;หยุด → Escalate&lt;/b&gt;&lt;br&gt;ให้คนตัดสินใจ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="780" y="1040" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- ===== Notes (left) ===== -->
        <mxCell id="noteExit" value="&lt;b&gt;Exit criteria (ตัวอย่าง)&lt;/b&gt;&lt;br&gt;• ไม่มี bug Critical/High ค้าง&lt;br&gt;• Coverage ≥ X%&lt;br&gt;• ทุกแถวใน Decision Table มี test&lt;br&gt;• Fuzz ครบ T นาที ไม่มี crash ใหม่" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fffde7;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="-180" y="90" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="noteLevels" value="&lt;b&gt;ยิ่งระดับสูง ยิ่งเป็น Black box&lt;/b&gt;&lt;br&gt;Unit → White&lt;br&gt;Integration → Grey&lt;br&gt;System → Black&lt;br&gt;Acceptance → Black + Human/AI" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fffde7;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="-180" y="420" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="noteReport" value="&lt;b&gt;คอลัมน์ Report Table&lt;/b&gt;&lt;br&gt;Level · Technique · Cases · Pass · Fail ·&lt;br&gt;Coverage · Defects (Sev) · Loops · Status" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#fffde7;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="-180" y="1160" width="300" height="80" as="geometry" />
        </mxCell>

        <!-- ===== Main edges ===== -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="start" target="plan"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="plan" target="design"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="design" target="unit"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="unit" target="g1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="ผ่าน" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontColor=#2e7d32;" edge="1" parent="1" source="g1" target="integ"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="integ" target="g2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="ผ่าน" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontColor=#2e7d32;" edge="1" parent="1" source="g2" target="system"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="system" target="g3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="ผ่าน" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontColor=#2e7d32;" edge="1" parent="1" source="g3" target="accept"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="accept" target="g4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="ผ่าน" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontColor=#2e7d32;" edge="1" parent="1" source="g4" target="report"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="report" target="end"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ===== Fail edges into Defect ===== -->
        <mxCell id="f1" value="ไม่ผ่าน" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;fontColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.2;" edge="1" parent="1" source="g1" target="defect"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="440" /><mxPoint x="460" y="774" /></Array></mxGeometry></mxCell>
        <mxCell id="f2" value="ไม่ผ่าน" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;fontColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.4;" edge="1" parent="1" source="g2" target="defect"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="650" /><mxPoint x="480" y="788" /></Array></mxGeometry></mxCell>
        <mxCell id="f3" value="ไม่ผ่าน" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;fontColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.6;" edge="1" parent="1" source="g3" target="defect"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="870" /><mxPoint x="480" y="802" /></Array></mxGeometry></mxCell>
        <mxCell id="f4" value="ไม่ครบ" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;fontColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="g4" target="defect"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="1085" /><mxPoint x="460" y="816" /></Array></mxGeometry></mxCell>

        <!-- ===== Loop edges ===== -->
        <mxCell id="l1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="1" source="defect" target="regress"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="l2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="1" source="regress" target="loopchk"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="l3" value="ไม่ → รันใหม่จาก Unit" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#6c8ebf;fontColor=#6c8ebf;dashed=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="loopchk" target="unit"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="925" /><mxPoint x="1040" y="335" /></Array></mxGeometry></mxCell>
        <mxCell id="l4" value="ใช่" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#d79b00;fontColor=#d79b00;" edge="1" parent="1" source="loopchk" target="escalate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="l5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#d79b00;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="escalate" target="report"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="1200" /></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
